<!--
    ProgressBar: rounded pastel pill; the fill glides to new values (MuzzleAssist.AnimateProgress) and an
    indeterminate shimmer sweeps across the track.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <Style x:Key="Muzzle.ProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="999" />
        <Setter Property="mz:MuzzleAssist.AnimateProgress" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="Root">
                        <mzc:SoftBorder x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}" />
                        <mzc:SoftBorder x:Name="Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}">
                            <mzc:SoftBorder.Width>
                                <MultiBinding Converter="{x:Static mzv:ProgressWidthConverter.Instance}">
                                    <Binding Path="(mz:MuzzleAssist.ProgressRatio)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualWidth" ElementName="Track" />
                                    <Binding Path="ActualHeight" ElementName="Track" />
                                </MultiBinding>
                            </mzc:SoftBorder.Width>
                            <!-- soft top sheen -->
                            <mzc:SoftBorder CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}">
                                <mzc:SoftBorder.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#40FFFFFF" />
                                        <GradientStop Offset="0.6" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </mzc:SoftBorder.Background>
                            </mzc:SoftBorder>
                        </mzc:SoftBorder>
                        <mzc:SoftBorder x:Name="Shimmer"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                Visibility="Collapsed">
                            <mzc:SoftBorder.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-0.75" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Offset="0.2" Color="#00000000" />
                                    <GradientStop Offset="0.5" Color="#FF000000" />
                                    <GradientStop Offset="0.8" Color="#00000000" />
                                </LinearGradientBrush>
                            </mzc:SoftBorder.OpacityMask>
                        </mzc:SoftBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Shimmer" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ShimmerStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Shimmer"
                                                         Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-0.75" To="0.75" Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ShimmerStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Root" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.ProgressBar.Lavender" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Muzzle.ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.Secondary}" />
    </Style>

    <Style x:Key="Muzzle.ProgressBar.Mint" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Muzzle.ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.Mint}" />
    </Style>

    <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Muzzle.ProgressBar}" />

</ResourceDictionary>