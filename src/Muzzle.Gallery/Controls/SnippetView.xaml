<UserControl x:Class="Muzzle.Gallery.Controls.SnippetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             x:Name="Root">
    <Expander Style="{StaticResource Muzzle.Expander.Flat}" Padding="14,8">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Show XAML" FontSize="13" />
                <Border Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muzzle.Chip}" Padding="8,1">
                    <TextBlock Text="copy-paste" FontSize="11" />
                </Border>
            </StackPanel>
        </Expander.Header>
        <Grid>
            <TextBox x:Name="CodeBox"
                     Text="{Binding Code, ElementName=Root, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Top"
                     FontFamily="{StaticResource Muzzle.FontFamily.Mono}"
                     FontSize="12.5"
                     Padding="14,12,90,12"
                     Background="{DynamicResource Muzzle.Brush.Surface}"
                     BorderThickness="0"
                     mz:MuzzleAssist.CornerRadius="10" />
            <Button x:Name="CopyButton"
                    Margin="0,8,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="12,4"
                    MinHeight="28"
                    FontSize="12"
                    Content="Copy"
                    Style="{StaticResource Muzzle.Button.Secondary}"
                    Click="OnCopyClick" />
        </Grid>
    </Expander>
</UserControl>