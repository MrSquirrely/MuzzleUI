<!--
    Keyboard focus: a soft lavender halo drawn just outside the control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <Style x:Key="Muzzle.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4"
                            CornerRadius="14"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource Muzzle.Brush.Secondary}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.FocusVisual.Round">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <mzc:SoftBorder Margin="-4"
                            CornerRadius="999"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource Muzzle.Brush.Secondary}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>