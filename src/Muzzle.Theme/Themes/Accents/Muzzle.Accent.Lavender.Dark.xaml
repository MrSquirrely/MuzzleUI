<!--
    Muzzle accent: Lavender (Soft Wisteria), Dark variant.

    Merged after Muzzle.Light.xaml / Muzzle.Dark.xaml (MuzzleThemeManager keeps it there), it redefines the
    primary ramp plus the secondary (Blush) and tertiary (Mint) roles so they never share the
    primary hue. Generated by tools/Generate-Palettes.ps1: edit the table there, not this file.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <sys:Boolean x:Key="Muzzle.AccentSlot">True</sys:Boolean>
    <sys:String x:Key="Muzzle.AccentName">Lavender</sys:String>

    <!-- Colours -->
    <Color x:Key="Muzzle.Color.Primary">#B8A9F2</Color>
    <Color x:Key="Muzzle.Color.PrimaryHover">#C9BDF7</Color>
    <Color x:Key="Muzzle.Color.PrimaryPressed">#A18FE3</Color>
    <Color x:Key="Muzzle.Color.PrimarySoft">#403B55</Color>
    <Color x:Key="Muzzle.Color.PrimarySoftHover">#4F4869</Color>
    <Color x:Key="Muzzle.Color.PrimaryText">#C9BDF7</Color>
    <Color x:Key="Muzzle.Color.OnPrimary">#181622</Color>
    <Color x:Key="Muzzle.Color.FocusRing">#80B8A9F2</Color>
    <Color x:Key="Muzzle.Color.PrimaryWash">#2A2638</Color>
    <Color x:Key="Muzzle.Color.Secondary">#F6A2B3</Color>
    <Color x:Key="Muzzle.Color.SecondarySoft">#3A2532</Color>
    <Color x:Key="Muzzle.Color.SecondarySoftHover">#4A2D3C</Color>
    <Color x:Key="Muzzle.Color.SecondarySoftPressed">#563443</Color>
    <Color x:Key="Muzzle.Color.SecondaryText">#F8BAC8</Color>
    <Color x:Key="Muzzle.Color.SecondaryWash">#2A2231</Color>
    <Color x:Key="Muzzle.Color.Tertiary">#A7E3D5</Color>
    <Color x:Key="Muzzle.Color.TertiarySoft">#1F3332</Color>
    <Color x:Key="Muzzle.Color.TertiaryText">#B9EADF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Muzzle.Brush.Primary" Color="{StaticResource Muzzle.Color.Primary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.PrimaryHover" Color="{StaticResource Muzzle.Color.PrimaryHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.PrimaryPressed" Color="{StaticResource Muzzle.Color.PrimaryPressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.PrimarySoft" Color="{StaticResource Muzzle.Color.PrimarySoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.PrimarySoftHover" Color="{StaticResource Muzzle.Color.PrimarySoftHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.PrimaryText" Color="{StaticResource Muzzle.Color.PrimaryText}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.OnPrimary" Color="{StaticResource Muzzle.Color.OnPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.FocusRing" Color="{StaticResource Muzzle.Color.FocusRing}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.PrimaryWash" Color="{StaticResource Muzzle.Color.PrimaryWash}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Secondary" Color="{StaticResource Muzzle.Color.Secondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SecondarySoft" Color="{StaticResource Muzzle.Color.SecondarySoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SecondarySoftHover" Color="{StaticResource Muzzle.Color.SecondarySoftHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SecondarySoftPressed" Color="{StaticResource Muzzle.Color.SecondarySoftPressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SecondaryText" Color="{StaticResource Muzzle.Color.SecondaryText}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SecondaryWash" Color="{StaticResource Muzzle.Color.SecondaryWash}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Tertiary" Color="{StaticResource Muzzle.Color.Tertiary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.TertiarySoft" Color="{StaticResource Muzzle.Color.TertiarySoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.TertiaryText" Color="{StaticResource Muzzle.Color.TertiaryText}" po:Freeze="True" />

</ResourceDictionary>