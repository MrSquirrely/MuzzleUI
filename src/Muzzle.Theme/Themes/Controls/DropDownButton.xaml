<!--
    DropDownButton / SplitButton: Muzzle buttons with a chevron pill and a springy menu card.
    The menu rows use Muzzle.MenuItem and Muzzle.MenuSeparator from Menu.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Button.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Menu.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.DropDownButton" TargetType="{x:Type mzc:DropDownButton}">
        <Setter Property="SegmentStyle" Value="{StaticResource Muzzle.Button}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:DropDownButton}">
                    <Grid>
                        <Button x:Name="PART_ToggleButton" Style="{TemplateBinding SegmentStyle}" Padding="16,8,12,8"
                                HorizontalContentAlignment="Stretch" mz:MuzzleAssist.Jelly="All">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <mzc:MuzzleIcon x:Name="Chevron" Margin="8,1,0,0" Kind="ChevronDown" IconSize="14" StrokeThickness="2.2" RenderTransformOrigin="0.5,0.5">
                                    <mzc:MuzzleIcon.RenderTransform>
                                        <RotateTransform />
                                    </mzc:MuzzleIcon.RenderTransform>
                                </mzc:MuzzleIcon>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               StaysOpen="False"
                               Placement="{TemplateBinding Placement}"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Grid Margin="14,4,14,18">
                                <mzc:SoftBorder x:Name="PART_MenuCard"
                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                Padding="6"
                                                CornerRadius="12"
                                                Background="{DynamicResource Muzzle.Brush.Surface}"
                                                BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                                                BorderThickness="1"
                                                mz:FocusTrap.IsEnabled="True"
                                                Effect="{Binding Source={x:Static mz:ShadowDepth.Floating}, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding DropDownContent}"
                                                          Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Instance}}" />
                                        <ItemsControl ItemsSource="{Binding MenuItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      KeyboardNavigation.DirectionalNavigation="Cycle"
                                                      Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Inverted}}">
                                            <ItemsControl.Resources>
                                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Muzzle.MenuItem}" />
                                                <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource Muzzle.MenuSeparator}" />
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                    </Grid>
                                </mzc:SoftBorder>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.SplitButton" TargetType="{x:Type mzc:SplitButton}">
        <Setter Property="SegmentStyle" Value="{StaticResource Muzzle.Button}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:SplitButton}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PART_PrimaryButton" Style="{TemplateBinding SegmentStyle}"
                                    mz:MuzzleAssist.CornerRadius="10,4,4,10" mz:MuzzleAssist.Jelly="All"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Button x:Name="PART_ToggleButton" Margin="2,0,0,0" Padding="9,8" Style="{TemplateBinding SegmentStyle}"
                                    mz:MuzzleAssist.CornerRadius="4,10,10,4" mz:MuzzleAssist.Jelly="All"
                                    ToolTip="More options" AutomationProperties.Name="More options">
                                <mzc:MuzzleIcon x:Name="Chevron" Kind="ChevronDown" IconSize="14" StrokeThickness="2.2" RenderTransformOrigin="0.5,0.5">
                                    <mzc:MuzzleIcon.RenderTransform>
                                        <RotateTransform />
                                    </mzc:MuzzleIcon.RenderTransform>
                                </mzc:MuzzleIcon>
                            </Button>
                        </StackPanel>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               StaysOpen="False"
                               Placement="{TemplateBinding Placement}"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Grid Margin="14,4,14,18">
                                <mzc:SoftBorder x:Name="PART_MenuCard"
                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                Padding="6"
                                                CornerRadius="12"
                                                Background="{DynamicResource Muzzle.Brush.Surface}"
                                                BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                                                BorderThickness="1"
                                                mz:FocusTrap.IsEnabled="True"
                                                Effect="{Binding Source={x:Static mz:ShadowDepth.Floating}, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding DropDownContent}"
                                                          Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Instance}}" />
                                        <ItemsControl ItemsSource="{Binding MenuItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      KeyboardNavigation.DirectionalNavigation="Cycle"
                                                      Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Inverted}}">
                                            <ItemsControl.Resources>
                                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Muzzle.MenuItem}" />
                                                <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource Muzzle.MenuSeparator}" />
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                    </Grid>
                                </mzc:SoftBorder>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:DropDownButton}" BasedOn="{StaticResource Muzzle.DropDownButton}" />
    <Style TargetType="{x:Type mzc:SplitButton}" BasedOn="{StaticResource Muzzle.SplitButton}" />

</ResourceDictionary>