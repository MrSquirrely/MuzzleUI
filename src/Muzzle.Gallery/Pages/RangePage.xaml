<UserControl x:Class="Muzzle.Gallery.Pages.RangePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             xmlns:local="clr-namespace:Muzzle.Gallery"
             xmlns:controls="clr-namespace:Muzzle.Gallery.Controls">
    <ScrollViewer Style="{StaticResource Gallery.PageScroller}">
        <StackPanel Margin="4,4,20,28">
            <TextBlock Text="Range" Style="{StaticResource Gallery.PageHeader}" />
            <TextBlock Style="{StaticResource Gallery.PageLead}"
                       Text="Slider thumbs swell on hover and grow squishy while dragged. Progress bars glide to each new value instead of jumping." />

            <mz:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Slider" Style="{StaticResource Gallery.SectionTitle}" />
                        <TextBlock Text="Drag the thumb, click anywhere on the track, or use the arrow keys." Style="{StaticResource Gallery.SectionLead}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Width="44" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                       Text="{Binding Value, ElementName=MainSlider, StringFormat={}{0:0}%}" FontWeight="SemiBold" />
                            <Slider x:Name="MainSlider" Minimum="0" Maximum="100" Value="42" AutomationProperties.Name="Fluffiness" />
                        </DockPanel>
                        <TextBlock Margin="0,18,0,6" Text="Ticks, snapping" Style="{StaticResource Muzzle.Text.Caption}" />
                        <Slider Minimum="0" Maximum="10" Value="6" TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True" />
                        <TextBlock Margin="0,18,0,6" Text="Lavender / disabled" Style="{StaticResource Muzzle.Text.Caption}" />
                        <Slider Minimum="0" Maximum="100" Value="70" Foreground="{DynamicResource Muzzle.Brush.Secondary}" />
                        <Slider Margin="0,8,0,0" Minimum="0" Maximum="100" Value="30" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="36,0,8,0" Orientation="Horizontal">
                        <Slider Orientation="Vertical" Height="190" Minimum="0" Maximum="100" Value="65" />
                        <Slider Margin="14,0,0,0" Orientation="Vertical" Height="190" Minimum="0" Maximum="100" Value="35"
                                Foreground="{DynamicResource Muzzle.Brush.Mint}" TickPlacement="BottomRight" TickFrequency="10" />
                    </StackPanel>
                </Grid>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="ProgressBar" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="The first bar follows the slider above. Use the buttons to watch the fill glide." Style="{StaticResource Gallery.SectionLead}" />
                    <ProgressBar Value="{Binding Value, ElementName=MainSlider}" />
                    <ProgressBar x:Name="DemoProgress" Margin="0,16,0,0" Height="14" Value="25" Style="{StaticResource Muzzle.ProgressBar.Lavender}" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button Margin="0,0,10,0" Content="0%" Tag="0" Click="OnSetProgress" Style="{StaticResource Muzzle.Button.Ghost}" />
                        <Button Margin="0,0,10,0" Content="25%" Tag="25" Click="OnSetProgress" Style="{StaticResource Muzzle.Button.Ghost}" />
                        <Button Margin="0,0,10,0" Content="60%" Tag="60" Click="OnSetProgress" Style="{StaticResource Muzzle.Button.Ghost}" />
                        <Button Margin="0,0,10,0" Content="100%" Tag="100" Click="OnSetProgress" Style="{StaticResource Muzzle.Button.Ghost}" />
                        <Button Content="Random" Click="OnRandomProgress" Style="{StaticResource Muzzle.Button.Secondary}" />
                    </WrapPanel>
                    <TextBlock Margin="0,18,0,6" Text="Indeterminate" Style="{StaticResource Muzzle.Text.Caption}" />
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource Muzzle.ProgressBar.Mint}" />
                    <controls:SnippetView Margin="0,18,0,0" Code="{x:Static local:Snippets.Range}" />
                </StackPanel>
            </mz:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>