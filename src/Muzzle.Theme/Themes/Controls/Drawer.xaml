<!--
    Drawer: a pastel surface docked to an edge with rounded inner corners and a floating shadow, over a dimmed mask.
    The panel extends a 24px "bounce gutter" past its docked edge (clipped) so the springy overshoot never shows a gap.
    Slide / mask animations live in Drawer.cs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <Style x:Key="Muzzle.Drawer" TargetType="{x:Type mzc:Drawer}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.SurfaceRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22,6,22,22" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Panel.ZIndex" Value="500" />
        <Setter Property="Grid.RowSpan" Value="100" />
        <Setter Property="Grid.ColumnSpan" Value="100" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="Floating" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Drawer}">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Border x:Name="PART_Mask" Background="{DynamicResource Muzzle.Brush.Backdrop}" />
                        <Grid x:Name="PART_Panel"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Margin="0,0,-24,0"
                              Width="{Binding DrawerSize, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:DoubleOffsetConverter.Instance}, ConverterParameter=24}"
                              KeyboardNavigation.TabNavigation="Cycle"
                              mz:FocusTrap.IsEnabled="True"
                              KeyboardNavigation.ControlTabNavigation="Cycle">
                            <mzc:SoftBorder x:Name="Surface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="16,0,0,16"
                                            Effect="{TemplateBinding mz:MuzzleAssist.ShadowDepth, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}" />
                            <DockPanel x:Name="Inner" Margin="0,0,24,0">
                                <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Margin="22,16,12,8" MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="HeaderPresenter"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      TextElement.FontSize="18"
                                                      TextElement.FontWeight="SemiBold" />
                                    <Button x:Name="PART_CloseButton"
                                            Grid.Column="1"
                                            Width="32" Height="32"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource Muzzle.Button.Icon}"
                                            mz:MuzzleAssist.CornerRadius="16"
                                            Visibility="{TemplateBinding CloseButtonVisibility}"
                                            ToolTip="{DynamicResource Muzzle.String.Drawer.Close}"
                                            AutomationProperties.Name="{DynamicResource Muzzle.String.Drawer.CloseDrawer}">
                                        <Path Width="10" Height="10" Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                              Stroke="{DynamicResource Muzzle.Brush.TextSecondary}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowMask" Value="False">
                            <Setter TargetName="PART_Mask" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Dock" Value="Left">
                            <Setter TargetName="PART_Panel" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_Panel" Property="Margin" Value="-24,0,0,0" />
                            <Setter TargetName="Inner" Property="Margin" Value="24,0,0,0" />
                            <Setter TargetName="Surface" Property="CornerRadius" Value="0,16,16,0" />
                        </Trigger>
                        <Trigger Property="Dock" Value="Top">
                            <Setter TargetName="PART_Panel" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Panel" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_Panel" Property="Margin" Value="0,-24,0,0" />
                            <Setter TargetName="PART_Panel" Property="Width" Value="NaN" />
                            <Setter TargetName="PART_Panel" Property="Height"
                                    Value="{Binding DrawerSize, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:DoubleOffsetConverter.Instance}, ConverterParameter=24}" />
                            <Setter TargetName="Inner" Property="Margin" Value="0,24,0,0" />
                            <Setter TargetName="Surface" Property="CornerRadius" Value="0,0,16,16" />
                        </Trigger>
                        <Trigger Property="Dock" Value="Bottom">
                            <Setter TargetName="PART_Panel" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Panel" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="PART_Panel" Property="Margin" Value="0,0,0,-24" />
                            <Setter TargetName="PART_Panel" Property="Width" Value="NaN" />
                            <Setter TargetName="PART_Panel" Property="Height"
                                    Value="{Binding DrawerSize, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:DoubleOffsetConverter.Instance}, ConverterParameter=24}" />
                            <Setter TargetName="Inner" Property="Margin" Value="0,0,0,24" />
                            <Setter TargetName="Surface" Property="CornerRadius" Value="16,16,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Drawer}" BasedOn="{StaticResource Muzzle.Drawer}" />

    <Style TargetType="{x:Type mzc:DrawerContainer}">
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

</ResourceDictionary>