<!--
    PropertyGrid: search bar, collapsible category cards with jelly expand/collapse, auto-generated
    Muzzle editors per property type, and a description panel that glides in on selection.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="Muzzle.BoolToVisibility" />

    <!-- Colour swatch toggle -->
    <Style x:Key="Muzzle.PropertyGrid.SwatchToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid mz:MuzzleAssist.Jelly="Hover, Press">
                        <Border CornerRadius="9" Background="{DynamicResource Muzzle.Brush.Surface}"
                                BorderBrush="{DynamicResource Muzzle.Brush.ControlBorder}" BorderThickness="1" />
                        <Border Margin="4" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Muzzle.Brush.SwatchOutline}" BorderThickness="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.PropertyGrid.PresetSwatch" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual.Round}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Swatch" CornerRadius="13" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Muzzle.Brush.SwatchOutline}" BorderThickness="1" mz:MuzzleAssist.Jelly="Hover, Press" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.TextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Editors -->
    <DataTemplate x:Key="Muzzle.PropertyGrid.TextEditor" DataType="{x:Type mzc:PropertyItem}">
        <TextBox x:Name="Editor"
                 Style="{DynamicResource Muzzle.TextBox.Compact}"
                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding DisplayName}" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Editor" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Danger}" />
                <Setter TargetName="Editor" Property="ToolTip" Value="{Binding ErrorText}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Muzzle.PropertyGrid.NumericEditor" DataType="{x:Type mzc:PropertyItem}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Editor"
                     Style="{DynamicResource Muzzle.TextBox.Compact}"
                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding DisplayName}" />
            <StackPanel Grid.Column="1" Margin="6,0,0,0" Orientation="Horizontal">
                <RepeatButton Style="{DynamicResource Muzzle.Button.Spin}" Command="{Binding DecrementCommand}"
                              AutomationProperties.Name="Decrease" Delay="350" Interval="60">
                    <Path Width="10" Height="10" Data="M 1,5 L 9,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </RepeatButton>
                <RepeatButton Margin="4,0,0,0" Style="{DynamicResource Muzzle.Button.Spin}" Command="{Binding IncrementCommand}"
                              AutomationProperties.Name="Increase" Delay="350" Interval="60">
                    <Path Width="10" Height="10" Data="M 1,5 L 9,5 M 5,1 L 5,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RepeatButton}}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </RepeatButton>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Editor" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Danger}" />
                <Setter TargetName="Editor" Property="ToolTip" Value="{Binding ErrorText}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Muzzle.PropertyGrid.RangeEditor" DataType="{x:Type mzc:PropertyItem}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Slider VerticalAlignment="Center"
                    Minimum="{Binding Minimum, Mode=OneTime}"
                    Maximum="{Binding Maximum, Mode=OneTime}"
                    SmallChange="{Binding SmallChange, Mode=OneTime}"
                    LargeChange="{Binding LargeChange, Mode=OneTime}"
                    IsSnapToTickEnabled="{Binding IsIntegral, Mode=OneTime}"
                    TickFrequency="{Binding SmallChange, Mode=OneTime}"
                    Value="{Binding NumericValue}"
                    AutomationProperties.Name="{Binding DisplayName}" />
            <TextBox x:Name="Editor"
                     Grid.Column="1"
                     Margin="10,0,0,0"
                     Style="{DynamicResource Muzzle.TextBox.Compact}"
                     HorizontalContentAlignment="Center"
                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Editor" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Danger}" />
                <Setter TargetName="Editor" Property="ToolTip" Value="{Binding ErrorText}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Muzzle.PropertyGrid.BooleanEditor" DataType="{x:Type mzc:PropertyItem}">
        <mzc:ToggleSwitch HorizontalAlignment="Left"
                          IsChecked="{Binding Value}"
                          AutomationProperties.Name="{Binding DisplayName}" />
    </DataTemplate>

    <DataTemplate x:Key="Muzzle.PropertyGrid.NullableBooleanEditor" DataType="{x:Type mzc:PropertyItem}">
        <CheckBox HorizontalAlignment="Left"
                  IsThreeState="True"
                  IsChecked="{Binding Value}"
                  Content="{Binding EditText}"
                  AutomationProperties.Name="{Binding DisplayName}" />
    </DataTemplate>

    <DataTemplate x:Key="Muzzle.PropertyGrid.EnumEditor" DataType="{x:Type mzc:PropertyItem}">
        <ComboBox MinHeight="32"
                  Padding="10,5,36,5"
                  FontSize="13"
                  ItemsSource="{Binding EnumValues, Mode=OneTime}"
                  SelectedItem="{Binding Value}"
                  mz:MuzzleAssist.CornerRadius="8"
                  AutomationProperties.Name="{Binding DisplayName}" />
    </DataTemplate>

    <DataTemplate x:Key="Muzzle.PropertyGrid.ColorEditor" DataType="{x:Type mzc:PropertyItem}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="Swatch"
                          Style="{StaticResource Muzzle.PropertyGrid.SwatchToggle}"
                          Background="{Binding SwatchBrush}"
                          IsChecked="{Binding IsOpen, ElementName=Presets, Mode=TwoWay}"
                          IsHitTestVisible="{Binding IsOpen, ElementName=Presets, Converter={x:Static mzv:InverseBooleanConverter.Instance}}"
                          ToolTip="Pick a pastel"
                          AutomationProperties.Name="Choose colour" />
            <TextBox x:Name="Editor"
                     Grid.Column="1"
                     Margin="8,0,0,0"
                     Style="{DynamicResource Muzzle.TextBox.Compact}"
                     FontFamily="{DynamicResource Muzzle.FontFamily.Mono}"
                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                     mz:MuzzleAssist.Placeholder="#RRGGBB"
                     AutomationProperties.Name="{Binding DisplayName}" />
            <Popup x:Name="Presets"
                   PlacementTarget="{Binding ElementName=Swatch}"
                   Placement="Bottom"
                   HorizontalOffset="-12"
                   VerticalOffset="2"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="None">
                <Grid x:Name="PresetHost" Margin="12,4,12,20" RenderTransformOrigin="0.2,0">
                    <Grid.RenderTransform>
                        <ScaleTransform />
                    </Grid.RenderTransform>
                    <Border Background="{DynamicResource Muzzle.Brush.Surface}"
                            BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Effect="{DynamicResource Muzzle.Shadow.Floating}" />
                    <StackPanel Margin="10">
                        <TextBlock Margin="3,0,0,6" Text="Pastel presets" Style="{DynamicResource Muzzle.Text.Overline}" />
                        <ItemsControl Width="128" ItemsSource="{Binding PresetColors, Mode=OneTime}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Muzzle.PropertyGrid.PresetSwatch}"
                                            Background="{Binding Converter={x:Static mzv:ColorToBrushConverter.Instance}}"
                                            ToolTip="{Binding}"
                                            Command="{Binding DataContext.ApplyColorCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Popup>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="Presets" Property="IsOpen" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PresetHost" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetName="PresetHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0.85" To="1" Duration="0:0:0.55" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                            <DoubleAnimation Storyboard.TargetName="PresetHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0.85" To="1" Duration="0:0:0.55" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="Editor" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Danger}" />
                <Setter TargetName="Editor" Property="ToolTip" Value="{Binding ErrorText}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Muzzle.PropertyGrid.ReadOnlyEditor" DataType="{x:Type mzc:PropertyItem}">
        <TextBlock VerticalAlignment="Center"
                   Text="{Binding EditText, Mode=OneWay}"
                   Foreground="{DynamicResource Muzzle.Brush.TextSecondary}"
                   FontStyle="Italic"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding TypeName}" />
    </DataTemplate>

    <mzc:PropertyEditorTemplateSelector x:Key="Muzzle.PropertyGrid.EditorSelector"
                                        TextTemplate="{StaticResource Muzzle.PropertyGrid.TextEditor}"
                                        NumericTemplate="{StaticResource Muzzle.PropertyGrid.NumericEditor}"
                                        RangeTemplate="{StaticResource Muzzle.PropertyGrid.RangeEditor}"
                                        BooleanTemplate="{StaticResource Muzzle.PropertyGrid.BooleanEditor}"
                                        NullableBooleanTemplate="{StaticResource Muzzle.PropertyGrid.NullableBooleanEditor}"
                                        EnumTemplate="{StaticResource Muzzle.PropertyGrid.EnumEditor}"
                                        ColorTemplate="{StaticResource Muzzle.PropertyGrid.ColorEditor}"
                                        ReadOnlyTemplate="{StaticResource Muzzle.PropertyGrid.ReadOnlyEditor}" />

    <!-- One property row -->
    <DataTemplate x:Key="Muzzle.PropertyGrid.RowTemplate" DataType="{x:Type mzc:PropertyItem}">
        <Border x:Name="Row"
                Margin="0,1"
                Padding="10,5"
                CornerRadius="10"
                Background="Transparent"
                Visibility="{Binding IsVisible, Converter={StaticResource Muzzle.BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="90" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Label"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{Binding DisplayName, Mode=OneTime}"
                           Foreground="{DynamicResource Muzzle.Brush.TextPrimary}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Description, Mode=OneTime}" />
                <ContentControl Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                Focusable="False"
                                IsTabStop="False"
                                Content="{Binding}"
                                ContentTemplateSelector="{StaticResource Muzzle.PropertyGrid.EditorSelector}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Muzzle.Brush.HoverTint}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Muzzle.Brush.PrimarySoft}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Muzzle.Brush.PrimaryText}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One category card -->
    <DataTemplate x:Key="Muzzle.PropertyGrid.CategoryTemplate" DataType="{x:Type mzc:PropertyCategory}">
        <Expander Margin="0,0,0,10"
                  Padding="12,9"
                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  Visibility="{Binding IsVisible, Converter={StaticResource Muzzle.BoolToVisibility}}"
                  Background="{DynamicResource Muzzle.Brush.SurfaceRaised}"
                  mz:MuzzleAssist.CornerRadius="12"
                  mz:MuzzleAssist.ShadowDepth="None">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name, Mode=OneTime}" />
                    <Border Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Muzzle.Chip}" Padding="8,1">
                        <TextBlock Text="{Binding VisibleCount}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Expander.Header>
            <ItemsControl Margin="-6,-4,-6,0"
                          Focusable="False"
                          ItemsSource="{Binding Items, Mode=OneTime}"
                          ItemTemplate="{StaticResource Muzzle.PropertyGrid.RowTemplate}" />
        </Expander>
    </DataTemplate>

    <Style x:Key="Muzzle.PropertyGrid" TargetType="{x:Type mzc:PropertyGrid}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.SurfaceRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="16" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="Soft" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:PropertyGrid}">
                    <Grid>
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                Effect="{TemplateBinding mz:MuzzleAssist.ShadowDepth, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="4,0,4,10" LastChildFill="True">
                                <Border DockPanel.Dock="Right" Style="{DynamicResource Muzzle.Chip}" VerticalAlignment="Center">
                                    <TextBlock>
                                        <Run Text="{Binding Properties.Count, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Run Text="props" />
                                    </TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Inspector" Style="{DynamicResource Muzzle.Text.Overline}" />
                                    <TextBlock x:Name="TypeName"
                                               Text="{TemplateBinding SelectedObjectTypeName}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>

                            <TextBox x:Name="PART_SearchBox"
                                     Grid.Row="1"
                                     Margin="0,0,0,12"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}"
                                     Visibility="{Binding ShowSearchBox, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Muzzle.BoolToVisibility}}"
                                     mz:MuzzleAssist.Placeholder="Search properties…"
                                     AutomationProperties.Name="Search properties" />

                            <ScrollViewer Grid.Row="2"
                                          Padding="0,0,4,0"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <ItemsControl x:Name="CategoryList"
                                                  Focusable="False"
                                                  ItemsSource="{TemplateBinding Categories}"
                                                  ItemTemplate="{StaticResource Muzzle.PropertyGrid.CategoryTemplate}" />
                                    <ItemsControl x:Name="FlatList"
                                                  Focusable="False"
                                                  Visibility="Collapsed"
                                                  ItemsSource="{TemplateBinding Properties}"
                                                  ItemTemplate="{StaticResource Muzzle.PropertyGrid.RowTemplate}" />
                                    <TextBlock x:Name="EmptyText"
                                               Margin="0,24"
                                               HorizontalAlignment="Center"
                                               Text="Nothing to inspect yet. Set SelectedObject to begin."
                                               Style="{DynamicResource Muzzle.Text.Secondary}"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="NoMatchesText"
                                               Margin="0,24"
                                               HorizontalAlignment="Center"
                                               Text="No properties match your search."
                                               Style="{DynamicResource Muzzle.Text.Secondary}"
                                               Visibility="Collapsed" />
                                </Grid>
                            </ScrollViewer>

                            <Border x:Name="DescriptionPanel"
                                    Grid.Row="3"
                                    Margin="0,12,0,0"
                                    Padding="14,10"
                                    MinHeight="66"
                                    CornerRadius="12"
                                    Background="{DynamicResource Muzzle.Brush.CanvasAlt}">
                                <StackPanel x:Name="DescriptionContent"
                                            DataContext="{Binding SelectedProperty, RelativeSource={RelativeSource TemplatedParent}, NotifyOnTargetUpdated=True}">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform />
                                    </StackPanel.RenderTransform>
                                    <StackPanel.Triggers>
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                     From="8" To="0" Duration="0:0:0.45" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </StackPanel.Triggers>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding TypeName, FallbackValue=''}"
                                                   FontFamily="{DynamicResource Muzzle.FontFamily.Mono}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Muzzle.Brush.PrimaryText}" />
                                        <TextBlock Text="{Binding DisplayName, FallbackValue='Select a property'}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Description, FallbackValue='Its description will appear here.'}"
                                               Style="{DynamicResource Muzzle.Text.Caption}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowCategories" Value="False">
                            <Setter TargetName="CategoryList" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FlatList" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasNoMatches" Value="True">
                            <Setter TargetName="NoMatchesText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SelectedObject" Value="{x:Null}">
                            <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TypeName" Property="Text" Value="No selection" />
                        </Trigger>
                        <Trigger Property="ShowDescription" Value="False">
                            <Setter TargetName="DescriptionPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:PropertyGrid}" BasedOn="{StaticResource Muzzle.PropertyGrid}" />

</ResourceDictionary>