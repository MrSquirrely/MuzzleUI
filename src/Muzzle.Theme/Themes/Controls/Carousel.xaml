<!--
    Carousel: a rounded media frame that slides between items with a BackEase overshoot, pill previous / next buttons
    and a floating row of dot indicators (the current one stretches into a bouncing pill).
    ImageViewer: a rounded pan-and-zoom frame with a floating zoom toolbar.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="Muzzle.Carousel.BoolToVisibility" />

    <!-- Round floating button used by the carousel arrows and the image viewer toolbar. -->
    <Style x:Key="Muzzle.Button.Floating" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.SurfaceRim}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="999" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="Soft" />
    </Style>

    <Style x:Key="Muzzle.Carousel" TargetType="{x:Type mzc:Carousel}">
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.CanvasAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="160" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Carousel}">
                    <Grid>
                        <mzc:SoftBorder Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                        Effect="{TemplateBinding mz:MuzzleAssist.ShadowDepth, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}" />
                        <Grid x:Name="PART_Viewport" Margin="{TemplateBinding BorderThickness}" ClipToBounds="True">
                            <ContentPresenter x:Name="PART_PresenterA"
                                              ContentTemplate="{TemplateBinding ItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}" />
                            <ContentPresenter x:Name="PART_PresenterB"
                                              ContentTemplate="{TemplateBinding ItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <Button x:Name="PART_PreviousButton"
                                Margin="14,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource Muzzle.Button.Floating}"
                                Visibility="{TemplateBinding ShowNavigationButtons, Converter={StaticResource Muzzle.Carousel.BoolToVisibility}}"
                                ToolTip="{DynamicResource Muzzle.String.Carousel.Previous}"
                                AutomationProperties.Name="{DynamicResource Muzzle.String.Carousel.Previous}">
                            <Path Width="7" Height="12" Data="M 6,1 L 1.5,6 L 6,11" Stroke="{DynamicResource Muzzle.Brush.TextPrimary}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,1,0" />
                        </Button>
                        <Button x:Name="PART_NextButton"
                                Margin="0,0,14,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource Muzzle.Button.Floating}"
                                Visibility="{TemplateBinding ShowNavigationButtons, Converter={StaticResource Muzzle.Carousel.BoolToVisibility}}"
                                ToolTip="{DynamicResource Muzzle.String.Carousel.Next}"
                                AutomationProperties.Name="{DynamicResource Muzzle.String.Carousel.Next}">
                            <Path Width="7" Height="12" Data="M 1,1 L 5.5,6 L 1,11" Stroke="{DynamicResource Muzzle.Brush.TextPrimary}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="1,0,0,0" />
                        </Button>
                        <Grid Margin="0,0,0,14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Visibility="{TemplateBinding ShowIndicators, Converter={StaticResource Muzzle.Carousel.BoolToVisibility}}">
                            <Border CornerRadius="10" Background="{DynamicResource Muzzle.Brush.Surface}" Opacity="0.85" />
                            <StackPanel x:Name="PART_Indicators" Margin="7,6" Orientation="Horizontal" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.ImageViewer" TargetType="{x:Type mzc:ImageViewer}">
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.CanvasAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="160" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:ImageViewer}">
                    <Grid>
                        <mzc:SoftBorder Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                        Effect="{TemplateBinding mz:MuzzleAssist.ShadowDepth, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}" />
                        <Grid x:Name="PART_Viewport" Margin="{TemplateBinding BorderThickness}" Background="Transparent" ClipToBounds="True">
                            <Image x:Name="PART_Image"
                                   Margin="{TemplateBinding Padding}"
                                   Source="{TemplateBinding Source}"
                                   Stretch="{TemplateBinding Stretch}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <Grid x:Name="Toolbar"
                              Margin="0,0,12,12"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Visibility="{TemplateBinding ShowToolbar, Converter={StaticResource Muzzle.Carousel.BoolToVisibility}}">
                            <mzc:SoftBorder CornerRadius="999" Background="{DynamicResource Muzzle.Brush.Surface}" BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                                            BorderThickness="1" Opacity="0.94" mz:MuzzleAssist.ShadowDepth="Soft"
                                            Effect="{Binding (mz:MuzzleAssist.ShadowDepth), RelativeSource={RelativeSource Self}, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}" />
                            <StackPanel Margin="4" Orientation="Horizontal">
                                <Button x:Name="PART_ZoomOutButton" Width="28" Height="28" Style="{StaticResource Muzzle.Button.Icon}" mz:MuzzleAssist.CornerRadius="999"
                                        Focusable="False" ToolTip="{DynamicResource Muzzle.String.ImageViewer.ZoomOut}" AutomationProperties.Name="{DynamicResource Muzzle.String.ImageViewer.ZoomOut}">
                                    <Path Width="10" Height="2" Data="M 1,1 H 9" Stroke="{DynamicResource Muzzle.Brush.TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <TextBlock MinWidth="44" VerticalAlignment="Center" TextAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muzzle.Brush.TextSecondary}"
                                           Text="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:P0}}" />
                                <Button x:Name="PART_ZoomInButton" Width="28" Height="28" Style="{StaticResource Muzzle.Button.Icon}" mz:MuzzleAssist.CornerRadius="999"
                                        Focusable="False" ToolTip="{DynamicResource Muzzle.String.ImageViewer.ZoomIn}" AutomationProperties.Name="{DynamicResource Muzzle.String.ImageViewer.ZoomIn}">
                                    <Path Width="10" Height="10" Data="M 1,5 H 9 M 5,1 V 9" Stroke="{DynamicResource Muzzle.Brush.TextPrimary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                                <Button x:Name="PART_ResetButton" Width="28" Height="28" Margin="2,0,0,0" Style="{StaticResource Muzzle.Button.Icon}" mz:MuzzleAssist.CornerRadius="999"
                                        Focusable="False" ToolTip="{DynamicResource Muzzle.String.ImageViewer.ResetZoomTip}" AutomationProperties.Name="{DynamicResource Muzzle.String.ImageViewer.ResetZoom}">
                                    <Path Width="12" Height="12" Data="M 2.2,7.6 A 4.2,4.2 0 1 0 3,3.2 M 1.6,1.2 V 3.8 H 4.2"
                                          Stroke="{DynamicResource Muzzle.Brush.TextPrimary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPanning" Value="True">
                            <Setter Property="Cursor" Value="ScrollAll" />
                        </Trigger>
                        <Trigger Property="Source" Value="{x:Null}">
                            <Setter TargetName="Toolbar" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Carousel}" BasedOn="{StaticResource Muzzle.Carousel}" />
    <Style TargetType="{x:Type mzc:ImageViewer}" BasedOn="{StaticResource Muzzle.ImageViewer}" />

</ResourceDictionary>