<!--
    Popover: anchor content plus a popup card with a directional arrow tail (it overlaps the card border on the
    anchor side). Placement, pop-open animation and hover / click handling live in Popover.cs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <BooleanToVisibilityConverter x:Key="Muzzle.Popover.BoolToVisibility" />

    <Style x:Key="Muzzle.Popover" TargetType="{x:Type mzc:Popover}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.SurfaceRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="14" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="Floating" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Popover}">
                    <Grid>
                        <ContentPresenter x:Name="PART_Anchor" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               Focusable="False"
                               PlacementTarget="{Binding ElementName=PART_Anchor}"
                               IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <!-- Margin lives one level down so the popup's measured size includes it (centering math). -->
                            <Grid>
                            <Grid x:Name="PART_Bubble" Margin="16" TextElement.Foreground="{TemplateBinding Foreground}">
                                <mzc:SoftBorder Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                                Effect="{TemplateBinding mz:MuzzleAssist.ShadowDepth, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding PopoverContent}"
                                                  ContentTemplate="{TemplateBinding PopoverContentTemplate}" />
                                <Path x:Name="Arrow"
                                      Width="18" Height="9"
                                      Margin="0,-8,0,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Data="M 0,9 L 9,0 L 18,9"
                                      Fill="{TemplateBinding Background}"
                                      Stroke="{TemplateBinding BorderBrush}"
                                      StrokeThickness="1"
                                      StrokeLineJoin="Round"
                                      Visibility="{Binding ShowArrow, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Muzzle.Popover.BoolToVisibility}}" />
                            </Grid>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Placement" Value="Top">
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="Arrow" Property="Margin" Value="0,0,0,-8" />
                            <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 9,9 L 18,0" />
                        </Trigger>
                        <Trigger Property="Placement" Value="Left">
                            <Setter TargetName="Arrow" Property="Width" Value="9" />
                            <Setter TargetName="Arrow" Property="Height" Value="18" />
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Arrow" Property="Margin" Value="0,0,-8,0" />
                            <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 9,9 L 0,18" />
                        </Trigger>
                        <Trigger Property="Placement" Value="Right">
                            <Setter TargetName="Arrow" Property="Width" Value="9" />
                            <Setter TargetName="Arrow" Property="Height" Value="18" />
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Arrow" Property="Margin" Value="-8,0,0,0" />
                            <Setter TargetName="Arrow" Property="Data" Value="M 9,0 L 0,9 L 9,18" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Popover}" BasedOn="{StaticResource Muzzle.Popover}" />

</ResourceDictionary>