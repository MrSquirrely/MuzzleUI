<UserControl x:Class="Muzzle.Gallery.Pages.ContainersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:Muzzle.Gallery"
             xmlns:controls="clr-namespace:Muzzle.Gallery.Controls">
    <ScrollViewer Style="{StaticResource Gallery.PageScroller}">
        <StackPanel Margin="4,4,20,28">
            <TextBlock Text="Containers" Style="{StaticResource Gallery.PageHeader}" />
            <TextBlock Style="{StaticResource Gallery.PageLead}"
                       Text="Cards and surfaces with soft elevation, a tab strip with a sliding pill, springy expanders, and minimalist scrollbars that widen when you reach for them." />

            <!-- Elevation -->
            <mz:Card>
                <StackPanel>
                    <TextBlock Text="Elevation" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="mz:MuzzleAssist.ShadowDepth on a Card or a plain Border (Muzzle.Surface style). Hover them, they are jelly too." Style="{StaticResource Gallery.SectionLead}" />
                    <UniformGrid Columns="5">
                        <Border Margin="0,0,14,6" Height="96" Style="{StaticResource Muzzle.Surface}" mz:MuzzleAssist.ShadowDepth="None" mz:MuzzleAssist.Jelly="Hover, Press">
                            <TextBlock Text="None" FontWeight="SemiBold" />
                        </Border>
                        <Border Margin="0,0,14,6" Height="96" Style="{StaticResource Muzzle.Surface}" mz:MuzzleAssist.ShadowDepth="Subtle" mz:MuzzleAssist.Jelly="Hover, Press">
                            <TextBlock Text="Subtle" FontWeight="SemiBold" />
                        </Border>
                        <Border Margin="0,0,14,6" Height="96" Style="{StaticResource Muzzle.Surface}" mz:MuzzleAssist.ShadowDepth="Soft" mz:MuzzleAssist.Jelly="Hover, Press">
                            <TextBlock Text="Soft" FontWeight="SemiBold" />
                        </Border>
                        <Border Margin="0,0,14,6" Height="96" Style="{StaticResource Muzzle.Surface}" mz:MuzzleAssist.ShadowDepth="Raised" mz:MuzzleAssist.Jelly="Hover, Press">
                            <TextBlock Text="Raised" FontWeight="SemiBold" />
                        </Border>
                        <Border Margin="0,0,0,6" Height="96" Style="{StaticResource Muzzle.Surface}" mz:MuzzleAssist.ShadowDepth="Floating" mz:MuzzleAssist.Jelly="Hover, Press">
                            <TextBlock Text="Floating" FontWeight="SemiBold" />
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </mz:Card>

            <!-- Tabs -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="TabControl" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Switch tabs to watch the pill slide and stretch; content fades up into place." Style="{StaticResource Gallery.SectionLead}" />
                    <TabControl Height="150">
                        <TabItem Header="Naps">
                            <TextBlock Style="{StaticResource Muzzle.Text.Secondary}"
                                       Text="09:00 sunbeam · 11:30 laptop keyboard · 14:00 laundry basket · 16:45 your chair, the moment you stand up." />
                        </TabItem>
                        <TabItem Header="Snacks">
                            <WrapPanel>
                                <Border Margin="0,0,8,8" Style="{StaticResource Muzzle.Chip}"><TextBlock Text="Tuna" /></Border>
                                <Border Margin="0,0,8,8" Style="{StaticResource Muzzle.Chip}" Background="{DynamicResource Muzzle.Brush.MintSoft}" TextElement.Foreground="{DynamicResource Muzzle.Brush.MintText}"><TextBlock Text="Salmon" /></Border>
                                <Border Margin="0,0,8,8" Style="{StaticResource Muzzle.Chip}" Background="{DynamicResource Muzzle.Brush.PrimarySoft}" TextElement.Foreground="{DynamicResource Muzzle.Brush.PrimaryText}"><TextBlock Text="Chicken" /></Border>
                            </WrapPanel>
                        </TabItem>
                        <TabItem Header="Playtime with the laser">
                            <StackPanel>
                                <mz:ToggleSwitch Content="Laser pointer armed" IsChecked="True" />
                                <Slider Margin="0,12,0,0" Value="60" Maximum="100" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Vet" IsEnabled="False" />
                    </TabControl>
                </StackPanel>
            </mz:Card>

            <!-- Expanders + scroll -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <mz:Card>
                    <StackPanel>
                        <TextBlock Text="Expander" Style="{StaticResource Gallery.SectionTitle}" />
                        <TextBlock Text="The body springs open with an elastic overshoot and folds away." Style="{StaticResource Gallery.SectionLead}" />
                        <Expander Header="Snack schedule" IsExpanded="True">
                            <TextBlock Style="{StaticResource Muzzle.Text.Secondary}" Text="Breakfast, second breakfast, elevenses, luncheon, afternoon tea, dinner, supper. And a midnight crunchy." />
                        </Expander>
                        <Expander Margin="0,12,0,0" Header="House rules">
                            <StackPanel>
                                <CheckBox Content="No cats on the counter" />
                                <CheckBox Margin="0,10,0,0" Content="Gentle paws only" IsChecked="True" />
                            </StackPanel>
                        </Expander>
                        <Expander Margin="0,12,0,0" Header="Flat variant" Style="{StaticResource Muzzle.Expander.Flat}">
                            <TextBlock Style="{StaticResource Muzzle.Text.Secondary}" Text="No border, no shadow. Nice for nesting inside cards." />
                        </Expander>
                    </StackPanel>
                </mz:Card>
                <mz:Card Grid.Column="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ScrollViewer" Style="{StaticResource Gallery.SectionTitle}" />
                        <TextBlock DockPanel.Dock="Top" Text="Hover the slim bar on the right: the thumb widens. Hover items for tooltips." Style="{StaticResource Gallery.SectionLead}" />
                        <Border Height="214" Style="{StaticResource Muzzle.Surface.Flat}" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl Focusable="False">
                                    <ItemsControl.ItemsSource>
                                        <x:Array Type="{x:Type sys:String}">
                                            <sys:String>Mochi</sys:String>
                                            <sys:String>Biscuit</sys:String>
                                            <sys:String>Pudding</sys:String>
                                            <sys:String>Tofu</sys:String>
                                            <sys:String>Noodle</sys:String>
                                            <sys:String>Pickle</sys:String>
                                            <sys:String>Waffles</sys:String>
                                            <sys:String>Dumpling</sys:String>
                                            <sys:String>Marshmallow</sys:String>
                                            <sys:String>Sesame</sys:String>
                                            <sys:String>Peaches</sys:String>
                                            <sys:String>Bean</sys:String>
                                        </x:Array>
                                    </ItemsControl.ItemsSource>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,2,8,2" Padding="12,8" CornerRadius="10" Background="{DynamicResource Muzzle.Brush.Surface}"
                                                    ToolTip="{Binding StringFormat='{}{0} says hello'}" mz:MuzzleAssist.Jelly="Hover, Press">
                                                <TextBlock Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </mz:Card>
            </Grid>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Snippet" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Card is a ContentControl; Muzzle.Surface, Muzzle.Surface.Flat and Muzzle.Chip are Border styles." Style="{StaticResource Gallery.SectionLead}" />
                    <controls:SnippetView Code="{x:Static local:Snippets.Containers}" />
                </StackPanel>
            </mz:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>