<!--
    TagInput: a Muzzle field whose WrapPanel holds pastel TagItem chips followed by the text entry.
    TagItem: a lavender pill with a round × button; highlighted (armed for Backspace) chips turn blush.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.TagItem" TargetType="{x:Type mzc:TagItem}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.SecondaryText}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.SecondarySoft}" />
        <Setter Property="Padding" Value="11,0,4,0" />
        <Setter Property="Margin" Value="0,3,6,3" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:TagItem}">
                    <mzc:SoftBorder x:Name="Body" CornerRadius="999" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" />
                            <Button x:Name="PART_RemoveButton"
                                    Margin="6,0,0,0"
                                    Width="20" Height="20"
                                    Style="{DynamicResource Muzzle.SquishPillButton}"
                                    Background="Transparent"
                                    Foreground="{TemplateBinding Foreground}"
                                    ToolTip="{DynamicResource Muzzle.String.TagInput.Remove}"
                                    AutomationProperties.Name="{DynamicResource Muzzle.String.TagInput.RemoveTag}">
                                <Path Width="8" Height="8" Data="M 1,1 L 7,7 M 7,1 L 1,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </mzc:SoftBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Muzzle.Brush.PrimarySoftHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.PrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Muzzle.Brush.SecondarySoftHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.TagInput" TargetType="{x:Type mzc:TagInput}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:TagInput}">
                    <Grid x:Name="Root">
                        <mzc:SoftBorder x:Name="FocusRing" Opacity="0" BorderThickness="3" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource Muzzle.Brush.FocusRing}"
                                        CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius, Converter={x:Static mzv:CornerRadiusOffsetConverter.Instance}, ConverterParameter=3}" />
                        <mzc:SoftBorder x:Name="Body"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}" />
                        <WrapPanel x:Name="PART_Panel" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <Grid MinWidth="90" Margin="4,3,0,3" VerticalAlignment="Center">
                                <TextBlock x:Name="Placeholder"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Muzzle.Brush.TextTertiary}"
                                           Opacity="0"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="PART_TextBox"
                                         MinHeight="26"
                                         VerticalContentAlignment="Center"
                                         Style="{DynamicResource Muzzle.ComboBox.EditableTextBox}"
                                         Foreground="{TemplateBinding Foreground}"
                                         AutomationProperties.Name="{DynamicResource Muzzle.String.TagInput.NewTag}" />
                            </Grid>
                        </WrapPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasTags" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=PART_TextBox}" Value="0">
                            <Setter TargetName="Placeholder" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <ThicknessAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Margin" From="0" To="-3" Duration="0:0:0.5"
                                                            EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ThicknessAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Margin" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:TagInput}" BasedOn="{StaticResource Muzzle.TagInput}" />
    <Style TargetType="{x:Type mzc:TagItem}" BasedOn="{StaticResource Muzzle.TagItem}" />

</ResourceDictionary>