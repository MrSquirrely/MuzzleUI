<!--
    Buttons: Muzzle.Button (neutral, implicit), Primary, Secondary (lavender), Mint, Ghost, Pill, Icon, Spin,
    plus an implicit ToggleButton and RepeatButton. All variants grow on hover, squish on press and spring back.

    Customise without templates:
        mz:MuzzleAssist.CornerRadius, mz:MuzzleAssist.ShadowDepth, mz:MuzzleAssist.JellyIntensity,
        mz:MuzzleAssist.HoverBackground, mz:MuzzleAssist.PressedBackground
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ControlTemplate x:Key="Muzzle.ButtonTemplate" TargetType="{x:Type ButtonBase}">
        <Grid x:Name="Root" mz:MuzzleAssist.Jelly="Hover, Press" SnapsToDevicePixels="True">
            <mzc:SoftBorder x:Name="Body"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                    Effect="{TemplateBinding mz:MuzzleAssist.ShadowDepth, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}">
                <Grid>
                    <mzc:SoftBorder x:Name="HoverLayer"
                            Background="{TemplateBinding mz:MuzzleAssist.HoverBackground}"
                            CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                            Opacity="0" />
                    <mzc:SoftBorder x:Name="PressLayer"
                            Background="{TemplateBinding mz:MuzzleAssist.PressedBackground}"
                            CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                            Opacity="0" />
                </Grid>
            </mzc:SoftBorder>
            <ContentPresenter x:Name="Presenter"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              Focusable="False"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.28" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.08" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.32" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Neutral surface button (implicit default). -->
    <Style x:Key="Muzzle.Button" TargetType="{x:Type ButtonBase}">
        <Setter Property="Template" Value="{StaticResource Muzzle.ButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="10" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="Subtle" />
        <Setter Property="mz:MuzzleAssist.HoverBackground" Value="{DynamicResource Muzzle.Brush.SurfaceRaised}" />
        <Setter Property="mz:MuzzleAssist.PressedBackground" Value="{DynamicResource Muzzle.Brush.CanvasAlt}" />
    </Style>

    <Style x:Key="Muzzle.Button.Primary" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button}">
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.OnPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="Soft" />
        <Setter Property="mz:MuzzleAssist.HoverBackground" Value="{DynamicResource Muzzle.Brush.PrimaryHover}" />
        <Setter Property="mz:MuzzleAssist.PressedBackground" Value="{DynamicResource Muzzle.Brush.PrimaryPressed}" />
    </Style>

    <Style x:Key="Muzzle.Button.Secondary" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button}">
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.SecondarySoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.SecondaryText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="None" />
        <Setter Property="mz:MuzzleAssist.HoverBackground" Value="{DynamicResource Muzzle.Brush.SecondarySoftHover}" />
        <Setter Property="mz:MuzzleAssist.PressedBackground" Value="{DynamicResource Muzzle.Brush.SecondarySoftPressed}" />
    </Style>

    <Style x:Key="Muzzle.Button.Mint" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button}">
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.MintSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.MintText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="None" />
        <Setter Property="mz:MuzzleAssist.HoverBackground" Value="{DynamicResource Muzzle.Brush.MintSoftHover}" />
        <Setter Property="mz:MuzzleAssist.PressedBackground" Value="{DynamicResource Muzzle.Brush.MintSoftPressed}" />
    </Style>

    <Style x:Key="Muzzle.Button.Ghost" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="mz:MuzzleAssist.ShadowDepth" Value="None" />
        <Setter Property="mz:MuzzleAssist.HoverBackground" Value="{DynamicResource Muzzle.Brush.HoverTint}" />
        <Setter Property="mz:MuzzleAssist.PressedBackground" Value="{DynamicResource Muzzle.Brush.PressTint}" />
    </Style>

    <Style x:Key="Muzzle.Button.Pill" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button.Primary}">
        <Setter Property="Padding" Value="22,9" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="999" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual.Round}" />
    </Style>

    <Style x:Key="Muzzle.Button.Icon" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button.Ghost}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Muzzle.Button.Spin" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Muzzle.Button.Ghost}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.CanvasAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextSecondary}" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="8" />
    </Style>

    <!-- ToggleButton: neutral when off, blush-soft when on. -->
    <Style x:Key="Muzzle.ToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Muzzle.Button}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.PrimarySoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.PrimaryText}" />
                <Setter Property="mz:MuzzleAssist.HoverBackground" Value="{DynamicResource Muzzle.Brush.PrimarySoftHover}" />
                <Setter Property="mz:MuzzleAssist.PressedBackground" Value="{DynamicResource Muzzle.Brush.PrimarySoftHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Muzzle.Button}" />
    <Style TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource Muzzle.Button}" />
    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Muzzle.ToggleButton}" />

</ResourceDictionary>