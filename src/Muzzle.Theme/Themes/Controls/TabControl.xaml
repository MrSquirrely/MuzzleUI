<!--
    TabControl: tabs sit in a cream "segmented" strip; a blush pill slides (and stretches) under the
    active tab, and the new page fades up into place. Supports all four TabStripPlacement values.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme">

    <Style x:Key="Muzzle.TabItem" TargetType="{x:Type TabItem}">
        <!-- Header visuals are set on the header presenter, not the TabItem, so they don't leak into tab content. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" Background="Transparent" mz:MuzzleAssist.Jelly="Press">
                        <Border x:Name="Hover"
                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                Background="{DynamicResource Muzzle.Brush.HoverTint}"
                                Opacity="0" />
                        <ContentPresenter x:Name="Presenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          Focusable="False"
                                          TextElement.FontSize="14"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource Muzzle.Brush.TextSecondary}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0" />
                            <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="{DynamicResource Muzzle.Brush.OnPrimary}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.TabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,16,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid x:Name="Root" KeyboardNavigation.TabNavigation="Local" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HeaderRow" Height="Auto" />
                            <RowDefinition x:Name="ContentRow" Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeaderColumn" Width="*" />
                            <ColumnDefinition x:Name="ContentColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HeaderStrip"
                                Grid.Row="0" Grid.Column="0"
                                HorizontalAlignment="Left"
                                Padding="4"
                                Background="{DynamicResource Muzzle.Brush.CanvasAlt}"
                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}">
                            <Grid x:Name="HeaderHost">
                                <Border x:Name="SelectionPill"
                                        CornerRadius="10"
                                        Background="{DynamicResource Muzzle.Brush.Primary}"
                                        Effect="{DynamicResource Muzzle.Shadow.Subtle}"
                                        IsHitTestVisible="False"
                                        mz:MuzzleAssist.TabIndicator="True" />
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Background="Transparent"
                                          KeyboardNavigation.TabIndex="1" />
                            </Grid>
                        </Border>
                        <Border x:Name="ContentPanel"
                                Grid.Row="1" Grid.Column="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="HeaderStrip" Property="Grid.Row" Value="1" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderRow" Property="Height" Value="*" />
                            <Setter TargetName="ContentRow" Property="Height" Value="Auto" />
                            <Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="0,0,0,16" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="HeaderStrip" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderStrip" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="HeaderColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="*" />
                            <Setter TargetName="HeaderRow" Property="Height" Value="*" />
                            <Setter TargetName="ContentRow" Property="Height" Value="0" />
                            <Setter TargetName="HeaderStrip" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="16,0,0,0" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="HeaderStrip" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderStrip" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="HeaderColumn" Property="Width" Value="*" />
                            <Setter TargetName="ContentColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="HeaderRow" Property="Height" Value="*" />
                            <Setter TargetName="ContentRow" Property="Height" Value="0" />
                            <Setter TargetName="HeaderStrip" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="0,0,16,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource Muzzle.TabControl}" />
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource Muzzle.TabItem}" />

</ResourceDictionary>