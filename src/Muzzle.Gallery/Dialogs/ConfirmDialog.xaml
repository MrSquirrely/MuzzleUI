<UserControl x:Class="Muzzle.Gallery.Dialogs.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="380">
    <StackPanel>
        <Border Width="44" Height="44" HorizontalAlignment="Left" CornerRadius="22" Background="{DynamicResource Muzzle.Brush.WarningSoft}">
            <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 8,3.5 V 9.4 M 8,12.4 V 12.5" Stroke="{DynamicResource Muzzle.Brush.WarningText}"
                  StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Border>
        <TextBlock x:Name="TitleText" Margin="0,16,0,6" Style="{StaticResource Muzzle.Text.Title}" />
        <TextBlock x:Name="MessageText" Style="{StaticResource Muzzle.Text.Secondary}" />
        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="Keep them" Style="{StaticResource Muzzle.Button.Ghost}" IsCancel="True" Click="OnNoClick" />
            <Button Margin="10,0,0,0" Content="Yes, do it" Style="{StaticResource Muzzle.Button.Primary}" IsDefault="True" Click="OnYesClick" />
        </StackPanel>
    </StackPanel>
</UserControl>