<UserControl x:Class="Muzzle.Gallery.Pages.UtilitiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             xmlns:local="clr-namespace:Muzzle.Gallery">

    <UserControl.Resources>
        <Style x:Key="Gallery.BehaviorTile" TargetType="Border">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Gallery.TileLabel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroller" Style="{StaticResource Gallery.PageScroller}">
        <StackPanel Margin="4,4,20,28">
            <TextBlock Text="Utilities &amp; behaviors" Style="{StaticResource Gallery.PageHeader}" />
            <TextBlock Style="{StaticResource Gallery.PageLead}"
                       Text="Attached behaviors that add jelly physics, rounded clipping, smooth scrolling and accessible focus handling to plain elements, plus converters, a one-line theme dictionary and a built-in icon pack." />

            <!-- JellyBehavior -->
            <mz:Card>
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="JellyBehavior" Style="{StaticResource Gallery.SectionTitle}" />
                            <TextBlock Text="Hover bounce, press squish and entrance animations for any FrameworkElement: these are plain Borders." Style="{StaticResource Gallery.SectionLead}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="Replay entrances" Click="OnReplayEntrances" Style="{StaticResource Muzzle.Button.Secondary}" />
                    </Grid>
                    <WrapPanel x:Name="BehaviorTiles">
                        <Border Style="{StaticResource Gallery.BehaviorTile}" Background="{DynamicResource Muzzle.Brush.PrimarySoft}"
                                mz:JellyBehavior.EnableHoverBounce="True" mz:JellyBehavior.HoverScale="1.06">
                            <TextBlock Style="{StaticResource Gallery.TileLabel}" Text="Hover bounce" Foreground="{DynamicResource Muzzle.Brush.PrimaryText}" />
                        </Border>
                        <Border Style="{StaticResource Gallery.BehaviorTile}" Background="{DynamicResource Muzzle.Brush.SecondarySoft}"
                                mz:JellyBehavior.EnablePressSquish="True" mz:JellyBehavior.PressSquishScale="0.9">
                            <TextBlock Style="{StaticResource Gallery.TileLabel}" Text="Press squish" Foreground="{DynamicResource Muzzle.Brush.SecondaryText}" />
                        </Border>
                        <Border Style="{StaticResource Gallery.BehaviorTile}" Background="{DynamicResource Muzzle.Brush.TertiarySoft}"
                                mz:JellyBehavior.EnableHoverBounce="True" mz:JellyBehavior.EnablePressSquish="True">
                            <TextBlock Style="{StaticResource Gallery.TileLabel}" Text="Both" Foreground="{DynamicResource Muzzle.Brush.TertiaryText}" />
                        </Border>
                        <Border Style="{StaticResource Gallery.BehaviorTile}" Background="{DynamicResource Muzzle.Brush.InfoSoft}"
                                mz:JellyBehavior.EntranceAnimation="PopIn" mz:JellyBehavior.EntranceDelay="0:0:0.05">
                            <TextBlock Style="{StaticResource Gallery.TileLabel}" Text="PopIn" Foreground="{DynamicResource Muzzle.Brush.InfoText}" />
                        </Border>
                        <Border Style="{StaticResource Gallery.BehaviorTile}" Background="{DynamicResource Muzzle.Brush.WarningSoft}"
                                mz:JellyBehavior.EntranceAnimation="SlideUp" mz:JellyBehavior.EntranceDelay="0:0:0.15">
                            <TextBlock Style="{StaticResource Gallery.TileLabel}" Text="SlideUp" Foreground="{DynamicResource Muzzle.Brush.WarningText}" />
                        </Border>
                        <Border Style="{StaticResource Gallery.BehaviorTile}" Background="{DynamicResource Muzzle.Brush.CanvasAlt}"
                                mz:JellyBehavior.EntranceAnimation="FadeIn" mz:JellyBehavior.EntranceDelay="0:0:0.25">
                            <TextBlock Style="{StaticResource Gallery.TileLabel}" Text="FadeIn" />
                        </Border>
                    </WrapPanel>
                    <mz:CodeBlock Margin="0,6,0,0" Language="xaml" Code="{x:Static local:Snippets.JellyBehavior}" />
                </StackPanel>
            </mz:Card>

            <!-- ClipHelper + ScrollViewerAssist -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <mz:Card>
                    <StackPanel>
                        <TextBlock Text="ClipHelper" Style="{StaticResource Gallery.SectionTitle}" />
                        <TextBlock Text="A rounded Border doesn't clip its child. ClipHelper.CornerRadius does, inside the border thickness." Style="{StaticResource Gallery.SectionLead}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <Border Height="130" CornerRadius="24" BorderThickness="3" BorderBrush="{DynamicResource Muzzle.Brush.Primary}">
                                    <Image Source="{StaticResource Gallery.GardenScene}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="Without: corners bleed" Style="{StaticResource Muzzle.Text.Caption}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <Border x:Name="ClippedFrame" Height="130" CornerRadius="24" BorderThickness="3" BorderBrush="{DynamicResource Muzzle.Brush.Primary}"
                                        mz:ClipHelper.CornerRadius="24">
                                    <Image Source="{StaticResource Gallery.GardenScene}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="With ClipHelper" Style="{StaticResource Muzzle.Text.Caption}" />
                            </StackPanel>
                        </UniformGrid>
                        <mz:CodeBlock Margin="0,14,0,0" Language="xaml" Code="{x:Static local:Snippets.ClipHelper}" />
                    </StackPanel>
                </mz:Card>
                <mz:Card Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="ScrollViewerAssist" Style="{StaticResource Gallery.SectionTitle}" />
                        <TextBlock Text="Right: smooth wheel scrolling, and Shift + wheel scrolls sideways. Left is a stock ScrollViewer." Style="{StaticResource Gallery.SectionLead}" />
                        <UniformGrid Columns="2">
                            <ScrollViewer Height="130" Margin="0,0,8,0" HorizontalScrollBarVisibility="Auto" mz:ClipHelper.CornerRadius="14">
                                <ItemsControl x:Name="PlainTiles" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <ScrollViewer x:Name="SmoothScroller" Height="130" Margin="8,0,0,0" HorizontalScrollBarVisibility="Auto"
                                          mz:ClipHelper.CornerRadius="14"
                                          mz:ScrollViewerAssist.EnableSmoothScroll="True"
                                          mz:ScrollViewerAssist.EnableShiftHorizontalScroll="True">
                                <ItemsControl x:Name="SmoothTiles" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </UniformGrid>
                        <mz:CodeBlock Margin="0,14,0,0" Language="xaml" Code="{x:Static local:Snippets.ScrollAssist}" />
                    </StackPanel>
                </mz:Card>
            </Grid>

            <!-- FocusTrap + EscapeKeyBehavior -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="FocusTrap &amp; EscapeKeyBehavior" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Open the panel: focus jumps inside, Tab and Shift+Tab cycle without escaping, and Esc closes it by setting the bound IsOpen back to false. Dialog, Drawer, menus and the command palette use the same trap." Style="{StaticResource Gallery.SectionLead}" />
                    <mz:ToggleSwitch x:Name="PanelSwitch" Content="Open the panel" />
                    <Border x:Name="TrapPanel" Margin="0,12,0,0" Padding="16" CornerRadius="14" HorizontalAlignment="Left" MinWidth="420"
                            Background="{DynamicResource Muzzle.Brush.CanvasAlt}"
                            Visibility="{Binding IsChecked, ElementName=PanelSwitch, Converter={x:Static mz:BoolToVisibilityConverter.Instance}}"
                            mz:FocusTrap.IsEnabled="True"
                            mz:FocusTrap.FocusFirstOnShow="True"
                            mz:EscapeKeyBehavior.IsOpen="{Binding IsChecked, ElementName=PanelSwitch}"
                            mz:JellyBehavior.EntranceAnimation="SlideUp">
                        <StackPanel>
                            <TextBlock Text="Adopt a kitten" FontWeight="SemiBold" />
                            <TextBox Margin="0,10,0,0" mz:MuzzleAssist.Placeholder="Your name" />
                            <TextBox Margin="0,8,0,0" mz:MuzzleAssist.Placeholder="Kitten's name" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Content="Adopt" Style="{StaticResource Muzzle.Button.Primary}" />
                                <Button Margin="8,0,0,0" Content="Cancel (or Esc)" Click="OnClosePanel" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <mz:CodeBlock Margin="0,14,0,0" Language="xaml" Code="{x:Static local:Snippets.FocusEscape}" />
                </StackPanel>
            </mz:Card>

            <!-- Converters -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Value converters" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="BoolToVisibility and NullToVisibility (both invertible), StringToInitials, and ColorToSoftTint for pastel washes of any colour." Style="{StaticResource Gallery.SectionLead}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="InitialsInput" Width="200" Text="Ada Lovelace" mz:MuzzleAssist.Placeholder="Type a name" />
                                <Border Width="40" Height="40" Margin="12,0,0,0" CornerRadius="20" Background="{DynamicResource Muzzle.Brush.PrimarySoft}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.PrimaryText}"
                                               Text="{Binding Text, ElementName=InitialsInput, Converter={x:Static mz:StringToInitialsConverter.Instance}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <CheckBox x:Name="ShowSecret" Content="Show the secret" />
                                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="The cat is on the keyboard."
                                           Visibility="{Binding IsChecked, ElementName=ShowSecret, Converter={x:Static mz:BoolToVisibilityConverter.Instance}}" />
                                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="(hidden)" Foreground="{DynamicResource Muzzle.Brush.TextTertiary}"
                                           Visibility="{Binding IsChecked, ElementName=ShowSecret, Converter={x:Static mz:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                            </StackPanel>
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <ComboBox x:Name="NapSpot" Width="200" mz:MuzzleAssist.Placeholder="Pick a nap spot">
                                    <sys:String>Sunny window</sys:String>
                                    <sys:String>Laundry basket</sys:String>
                                    <sys:String>Keyboard</sys:String>
                                </ComboBox>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Nice choice!"
                                           Visibility="{Binding SelectedItem, ElementName=NapSpot, Converter={x:Static mz:NullToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" x:Name="TintSwatches" VerticalAlignment="Top" />
                    </Grid>
                    <mz:CodeBlock Margin="0,14,0,0" Language="xaml" Code="{x:Static local:Snippets.Converters}" />
                </StackPanel>
            </mz:Card>

            <!-- Theme dictionary -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="MuzzleThemeResourceDictionary" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="The whole theme, its base theme and its accent in one declarative line. The first frame already has the right colours; with System it keeps following Windows." Style="{StaticResource Gallery.SectionLead}" />
                    <mz:CodeBlock Language="xaml" ShowLineNumbers="True" Code="{x:Static local:Snippets.ThemeDictionary}" />
                </StackPanel>
            </mz:Card>

            <!-- Icons -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="MuzzleIcon" Style="{StaticResource Gallery.SectionTitle}" />
                            <TextBlock x:Name="IconCount" Style="{StaticResource Gallery.SectionLead}" />
                        </StackPanel>
                        <mz:SearchBar x:Name="IconSearch" Width="240" HorizontalAlignment="Right" VerticalAlignment="Top" mz:MuzzleAssist.Placeholder="Filter icons…"
                                      TextChanged="OnIconSearchChanged" />
                    </Grid>
                    <ItemsControl x:Name="IconGrid" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="98" Height="78" Margin="0,0,6,6" CornerRadius="12" Background="{DynamicResource Muzzle.Brush.CanvasAlt}"
                                        ToolTip="{Binding}" mz:JellyBehavior.EnableHoverBounce="True" mz:JellyBehavior.HoverScale="1.06">
                                    <StackPanel VerticalAlignment="Center">
                                        <mz:MuzzleIcon Kind="{Binding}" IconSize="24" />
                                        <TextBlock Margin="4,8,4,0" HorizontalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding}" Foreground="{DynamicResource Muzzle.Brush.TextSecondary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <mz:CodeBlock Margin="0,10,0,0" Language="xaml" Code="{x:Static local:Snippets.Icons}" />
                </StackPanel>
            </mz:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>