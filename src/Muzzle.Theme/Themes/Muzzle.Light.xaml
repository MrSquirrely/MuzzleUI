    <SolidColorBrush x:Key="Muzzle.Brush.BackdropCanvas" Color="{StaticResource Muzzle.Color.BackdropCanvas}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Shadow" Color="{StaticResource Muzzle.Color.Shadow}" po:Freeze="True" />

    <!-- Elevated-surface border: a 1px rim highlight on the top edge fading into the normal border. -->
    <LinearGradientBrush x:Key="Muzzle.Brush.SurfaceRim" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3" po:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Muzzle.Color.SurfaceRimHighlight}" />
        <GradientStop Offset="0.34" Color="{StaticResource Muzzle.Color.SurfaceRimHighlight}" />
        <GradientStop Offset="1" Color="{StaticResource Muzzle.Color.SurfaceBorder}" />
    </LinearGradientBrush>

    <!-- Transparency checkerboard (colour pickers, alpha previews). -->
    <DrawingBrush x:Key="Muzzle.Brush.Checker" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute" po:Freeze="True">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Muzzle.Brush.Surface}" Geometry="M 0,0 H 10 V 10 H 0 Z" />
                <GeometryDrawing Brush="{StaticResource Muzzle.Brush.SurfaceBorder}" Geometry="M 0,0 H 5 V 5 H 0 Z M 5,5 H 10 V 10 H 5 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Elevation shadows -->
    <DropShadowEffect x:Key="Muzzle.Shadow.Subtle" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.08"
                      Color="{StaticResource Muzzle.Color.Shadow}" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Muzzle.Shadow.Soft" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.09"
                      Color="{StaticResource Muzzle.Color.Shadow}" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Muzzle.Shadow.Raised" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.12"
                      Color="{StaticResource Muzzle.Color.Shadow}" RenderingBias="Performance" po:Freeze="True" />
    <DropShadowEffect x:Key="Muzzle.Shadow.Floating" BlurRadius="24" ShadowDepth="10" Direction="270" Opacity="0.15"
                      Color="{StaticResource Muzzle.Color.Shadow}" RenderingBias="Performance" po:Freeze="True" />

</ResourceDictionary>