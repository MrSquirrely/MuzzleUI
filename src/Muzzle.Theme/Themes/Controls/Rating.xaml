<!--
    Rating: a row of RatingItems (built in Rating.cs). Fill is blush, empty is the soft track colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <Style x:Key="Muzzle.Rating" TargetType="{x:Type mzc:Rating}">
        <Setter Property="FillBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="EmptyBrush" Value="{DynamicResource Muzzle.Brush.Track}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource Muzzle.String.Rating.Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Rating}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <StackPanel x:Name="PART_Panel" Orientation="Horizontal" Background="Transparent" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Rating}" BasedOn="{StaticResource Muzzle.Rating}" />

</ResourceDictionary>