<!--
    Skeleton: placeholder blocks (built in Skeleton.cs) with a diagonal shimmer that is masked to the blocks'
    shapes, cross-fading into the real content when IsLoading turns False.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.Skeleton" TargetType="{x:Type mzc:Skeleton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Skeleton}">
                    <Grid>
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <Grid x:Name="Placeholder" IsHitTestVisible="False">
                            <!-- Near-transparent background keeps the visual brush aligned with the full area. -->
                            <Grid x:Name="PART_Blocks" Background="#01FFFFFF" />
                            <Border x:Name="Shimmer">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0.3" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.5" Color="{DynamicResource Muzzle.Color.Shimmer}" />
                                        <GradientStop Offset="0.7" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- OpacityMask: a VisualBrush of PART_Blocks, set in Skeleton.OnApplyTemplate. -->
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="ContentHost" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="ContentHost" Property="Focusable" Value="False" />
                            <Setter TargetName="ContentHost" Property="KeyboardNavigation.TabNavigation" Value="None" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Placeholder" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Placeholder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                                <BeginStoryboard x:Name="ShimmerSweep">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Shimmer"
                                                         Storyboard.TargetProperty="(Border.Background).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                         From="-1" To="1" Duration="0:0:1.5">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ShimmerSweep" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Placeholder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Placeholder" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.08" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="8" To="0" BeginTime="0:0:0.08" Duration="0:0:0.5" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsLoading" Value="False">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Skeleton}" BasedOn="{StaticResource Muzzle.Skeleton}" />

</ResourceDictionary>