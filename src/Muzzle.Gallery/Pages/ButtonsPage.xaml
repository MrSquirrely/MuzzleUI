<UserControl x:Class="Muzzle.Gallery.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             xmlns:local="clr-namespace:Muzzle.Gallery"
             xmlns:controls="clr-namespace:Muzzle.Gallery.Controls">
    <ScrollViewer Style="{StaticResource Gallery.PageScroller}">
        <StackPanel Margin="4,4,20,28">
            <TextBlock Text="Buttons" Style="{StaticResource Gallery.PageHeader}" />
            <TextBlock Style="{StaticResource Gallery.PageLead}"
                       Text="Every button grows 3% on hover, squishes to 0.94 × 0.92 on press and springs back with an elastic overshoot when released. Try the keyboard too: Space squishes, Enter boops." />

            <mz:Card>
                <StackPanel>
                    <TextBlock Text="Variants" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Primary (the accent), Secondary (a supporting colour that steps aside from the accent), Mint, Neutral, Ghost and Pill." Style="{StaticResource Gallery.SectionLead}" />
                    <WrapPanel>
                        <Button Margin="0,0,12,12" Content="Primary" Style="{StaticResource Muzzle.Button.Primary}" />
                        <Button Margin="0,0,12,12" Content="Secondary" Style="{StaticResource Muzzle.Button.Secondary}" />
                        <Button Margin="0,0,12,12" Content="Mint" Style="{StaticResource Muzzle.Button.Mint}" />
                        <Button Margin="0,0,12,12" Content="Neutral" />
                        <Button Margin="0,0,12,12" Content="Ghost" Style="{StaticResource Muzzle.Button.Ghost}" />
                        <Button Margin="0,0,12,12" Content="Pill button" Style="{StaticResource Muzzle.Button.Pill}" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,12" Text="Disabled: softened opacity, never harsh grey" Style="{StaticResource Muzzle.Text.Overline}" />
                    <WrapPanel>
                        <Button Margin="0,0,12,12" Content="Primary" Style="{StaticResource Muzzle.Button.Primary}" IsEnabled="False" />
                        <Button Margin="0,0,12,12" Content="Secondary" Style="{StaticResource Muzzle.Button.Secondary}" IsEnabled="False" />
                        <Button Margin="0,0,12,12" Content="Neutral" IsEnabled="False" />
                        <Button Margin="0,0,12,12" Content="Pill" Style="{StaticResource Muzzle.Button.Pill}" IsEnabled="False" />
                    </WrapPanel>
                    <controls:SnippetView Margin="0,8,0,0" Code="{x:Static local:Snippets.Buttons}" />
                </StackPanel>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="With icons and toggles" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Content is just content: drop paths, images or stacks inside. ToggleButton blushes when checked." Style="{StaticResource Gallery.SectionLead}" />
                    <WrapPanel>
                        <Button Margin="0,0,12,12" Style="{StaticResource Muzzle.Button.Primary}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" Fill="{DynamicResource Muzzle.Brush.OnPrimary}"
                                      Data="M 7,12.5 C 7,12.5 1,8.6 1,4.6 C 1,2.6 2.6,1 4.4,1 C 5.6,1 6.5,1.7 7,2.6 C 7.5,1.7 8.4,1 9.6,1 C 11.4,1 13,2.6 13,4.6 C 13,8.6 7,12.5 7,12.5 Z" />
                                <TextBlock Text="Favourite" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,12,12" Style="{StaticResource Muzzle.Button.Mint}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" Stroke="{DynamicResource Muzzle.Brush.MintText}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 1,7 L 5,11 L 13,2" />
                                <TextBlock Text="Done" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,12,12" Style="{StaticResource Muzzle.Button.Icon}" ToolTip="Settings" AutomationProperties.Name="Settings">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Muzzle.Brush.TextSecondary}" StrokeThickness="1.6"
                                  Data="M 8,5.5 A 2.5,2.5 0 1 1 7.99,5.5 M 8,1 V 3 M 8,13 V 15 M 1,8 H 3 M 13,8 H 15 M 3,3 L 4.4,4.4 M 11.6,11.6 L 13,13 M 3,13 L 4.4,11.6 M 11.6,4.4 L 13,3" />
                        </Button>
                        <Button Margin="0,0,12,12" Style="{StaticResource Muzzle.Button.Icon}" ToolTip="Add" AutomationProperties.Name="Add">
                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Muzzle.Brush.TextSecondary}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,1 V 13 M 1,7 H 13" />
                        </Button>
                        <ToggleButton Margin="0,0,12,12" Content="Toggle me" IsChecked="True" />
                        <ToggleButton Margin="0,0,12,12" Content="Me too" />
                    </WrapPanel>
                </StackPanel>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Customise through MuzzleAssist" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Corner radius, shadow depth and jelly intensity are attached properties, so no template copying is needed." Style="{StaticResource Gallery.SectionLead}" />
                    <WrapPanel>
                        <Button Margin="0,0,12,12" Content="Square-ish" Style="{StaticResource Muzzle.Button.Primary}" mz:MuzzleAssist.CornerRadius="4" />
                        <Button Margin="0,0,12,12" Content="Extra round" Style="{StaticResource Muzzle.Button.Primary}" mz:MuzzleAssist.CornerRadius="18" Padding="22,12" />
                        <Button Margin="0,0,12,12" Content="Floating" Style="{StaticResource Muzzle.Button.Secondary}" mz:MuzzleAssist.ShadowDepth="Floating" />
                        <Button Margin="0,0,12,12" Content="Barely jelly (0.3)" mz:MuzzleAssist.JellyIntensity="0.3" />
                        <Button Margin="0,0,12,12" Content="Max jelly (3)" Style="{StaticResource Muzzle.Button.Mint}" mz:MuzzleAssist.JellyIntensity="3" />
                        <Button Margin="0,0,12,12" Content="Custom hover"
                                mz:MuzzleAssist.HoverBackground="{DynamicResource Muzzle.Brush.MintSoft}"
                                mz:MuzzleAssist.PressedBackground="{DynamicResource Muzzle.Brush.MintSoftHover}" />
                    </WrapPanel>
                </StackPanel>
            </mz:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>