<UserControl x:Class="Muzzle.Gallery.Pages.NavigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             xmlns:local="clr-namespace:Muzzle.Gallery"
             xmlns:controls="clr-namespace:Muzzle.Gallery.Controls">
    <ScrollViewer Style="{StaticResource Gallery.PageScroller}">
        <StackPanel Margin="4,4,20,28">
            <TextBlock Text="Navigation &amp; layout" Style="{StaticResource Gallery.PageHeader}" />
            <TextBlock Style="{StaticResource Gallery.PageLead}"
                       Text="The sidebar of this gallery is a NavigationView. Below: breadcrumbs, pagination, animated content transitions and step trackers, all with the same springy pills and squish." />

            <!-- NavigationView -->
            <mz:Card>
                <StackPanel>
                    <TextBlock Text="NavigationView" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Icon + label items, a pill that slides to the selection, and a pane that springs between compact and open. Try the hamburger." Style="{StaticResource Gallery.SectionLead}" />
                    <Grid Height="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <mz:NavigationView x:Name="DemoNav"
                                           OpenPaneLength="200"
                                           CompactPaneLength="60"
                                           mz:MuzzleAssist.ShadowDepth="Subtle"
                                           SelectedIndex="0"
                                           SelectionChanged="OnDemoNavChanged">
                            <mz:NavigationView.PaneHeader>
                                <TextBlock Text="Cat café" FontWeight="SemiBold" FontSize="15" />
                            </mz:NavigationView.PaneHeader>
                            <mz:NavigationView.PaneFooter>
                                <mz:ToggleSwitch Margin="10,0" Content="Open late" FontSize="13" />
                            </mz:NavigationView.PaneFooter>
                            <mz:NavigationViewItem Content="Lounge" IconGeometry="M 2,8 L 8,2.5 L 14,8 M 4,6.5 V 14 H 12 V 6.5" />
                            <mz:NavigationViewItem Content="Menu" IconGeometry="M 3,3 H 13 M 3,8 H 13 M 3,13 H 9" />
                            <mz:NavigationViewItem Content="Residents" IconGeometry="M 8,2.5 C 12,2.5 14,5.5 13.6,9 C 13.2,12.4 10.8,13.8 8,13.6 C 5,13.4 2.4,12 2.4,8.6 C 2.4,5 4.6,2.5 8,2.5 Z" />
                            <mz:NavigationViewItem Content="Bookings" IconGeometry="M 3,3.5 H 13 V 13.5 H 3 Z M 3,6.5 H 13 M 6,2 V 5 M 10,2 V 5" />
                        </mz:NavigationView>
                        <Border Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource Muzzle.Surface.Flat}">
                            <mz:TransitioningContentControl x:Name="DemoNavContent" Transition="SlideLeft" />
                        </Border>
                    </Grid>
                </StackPanel>
            </mz:Card>

            <!-- Breadcrumbs -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="BreadcrumbBar" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Click a segment to jump back up. Narrow the bar to watch middle segments fold into an ellipsis." Style="{StaticResource Gallery.SectionLead}" />
                    <Border HorizontalAlignment="Left" Padding="6,4" CornerRadius="12" Background="{DynamicResource Muzzle.Brush.CanvasAlt}"
                            Width="{Binding Value, ElementName=CrumbWidth}">
                        <mz:BreadcrumbBar x:Name="Crumbs" ItemClicked="OnCrumbClicked" />
                    </Border>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Width" Style="{StaticResource Muzzle.Text.Caption}" />
                        <Slider x:Name="CrumbWidth" Grid.Column="1" Margin="12,0" Minimum="180" Maximum="760" Value="620" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Go deeper" Click="OnCrumbDeeper" Style="{StaticResource Muzzle.Button.Secondary}" />
                            <Button Margin="8,0,0,0" Content="Reset" Click="OnCrumbReset" Style="{StaticResource Muzzle.Button.Ghost}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CrumbStatus" Margin="2,10,0,0" Style="{StaticResource Muzzle.Text.Caption}" Text="Clicked: nothing yet" />
                </StackPanel>
            </mz:Card>

            <!-- Pagination -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Pagination" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="The pill bounces to the current page; first / previous / next / last and the jump box squish when pressed." Style="{StaticResource Gallery.SectionLead}" />
                    <mz:Pagination x:Name="Pager" PageCount="24" CurrentPage="1" MaxDisplayedPages="7" ShowJumpBox="True" PageChanged="OnPageChanged" />
                    <TextBlock x:Name="PageStatus" Margin="2,12,0,0" Style="{StaticResource Muzzle.Text.Caption}" />
                    <mz:Pagination Margin="0,14,0,0" PageCount="5" CurrentPage="3" ShowFirstLastButtons="False" />
                </StackPanel>
            </mz:Card>

            <!-- Transitions -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="TransitioningContentControl" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Every content swap animates. The gallery's own page host uses SlideUp." Style="{StaticResource Gallery.SectionLead}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="TransitionPicker" Width="170" SelectionChanged="OnTransitionPicked" AutomationProperties.Name="Transition" />
                        <Button Margin="10,0,0,0" Content="Next card" Click="OnNextCard" Style="{StaticResource Muzzle.Button.Primary}" />
                    </StackPanel>
                    <mz:TransitioningContentControl x:Name="CardHost" Margin="0,16,0,0" Height="120" Transition="ScalePop" />
                </StackPanel>
            </mz:Card>

            <!-- StepBar -->
            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="StepBar" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Completed steps pop in with a checkmark and the track fills smoothly. Horizontal and vertical share StepIndex here." Style="{StaticResource Gallery.SectionLead}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <mz:StepBar x:Name="Steps" StepIndex="1">
                                <mz:StepBarItem Content="Pick a kitten" />
                                <mz:StepBarItem Content="Meet &amp; greet" />
                                <mz:StepBarItem Content="Home check" />
                                <mz:StepBarItem Content="Adoption day" />
                            </mz:StepBar>
                            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button Content="Back" Click="OnStepBack" Style="{StaticResource Muzzle.Button.Ghost}" />
                                <Button Margin="10,0,0,0" Content="Next step" Click="OnStepNext" Style="{StaticResource Muzzle.Button.Primary}" />
                            </StackPanel>
                        </StackPanel>
                        <mz:StepBar Grid.Column="1" Height="210" Margin="24,0,0,0" Orientation="Vertical"
                                    StepIndex="{Binding StepIndex, ElementName=Steps}">
                            <mz:StepBarItem Content="Pick a kitten" />
                            <mz:StepBarItem Content="Meet &amp; greet" />
                            <mz:StepBarItem Content="Home check" />
                            <mz:StepBarItem Content="Adoption day" />
                        </mz:StepBar>
                    </Grid>
                </StackPanel>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Snippet" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="All five controls are in the mz namespace and styled by Muzzle.xaml." Style="{StaticResource Gallery.SectionLead}" />
                    <controls:SnippetView Code="{x:Static local:Snippets.Navigation}" />
                </StackPanel>
            </mz:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>