<!--
    Avatar: a picture clipped to a circle or squircle, falling back to two-letter initials on a deterministic pastel,
    with an optional presence dot ringed in the surface colour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <Style x:Key="Muzzle.Avatar" TargetType="{x:Type mzc:Avatar}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Avatar}">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                        <mzc:SoftBorder x:Name="Frame"
                                        CornerRadius="{TemplateBinding ShapeCornerRadius}"
                                        Background="{DynamicResource Muzzle.Brush.PrimarySoft}">
                            <Grid>
                                <TextBlock x:Name="InitialsText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Initials}"
                                           FontSize="{TemplateBinding InitialsFontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{DynamicResource Muzzle.Brush.PrimaryText}" />
                                <!-- Shown when there is neither an image nor a name. -->
                                <Grid x:Name="PersonGlyph" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22*" />
                                        <ColumnDefinition Width="56*" />
                                        <ColumnDefinition Width="22*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20*" />
                                        <RowDefinition Height="56*" />
                                        <RowDefinition Height="24*" />
                                    </Grid.RowDefinitions>
                                    <Viewbox Grid.Row="1" Grid.Column="1">
                                        <Path Width="16" Height="16"
                                              Data="M 8,1.5 A 3.2,3.2 0 1 1 7.99,1.5 Z M 2,15 C 2,11.2 4.6,9.4 8,9.4 C 11.4,9.4 14,11.2 14,15 Z"
                                              Fill="{Binding Foreground, ElementName=InitialsText}" />
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </mzc:SoftBorder>
                        <mzc:SoftBorder x:Name="Photo"
                                        CornerRadius="{TemplateBinding ShapeCornerRadius}"
                                        Background="{TemplateBinding ImageFill}"
                                        Visibility="Collapsed" />
                        <mzc:SoftBorder CornerRadius="{TemplateBinding ShapeCornerRadius}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False" />
                        <mzc:SoftBorder x:Name="PART_StatusDot"
                                        Width="{TemplateBinding StatusDotSize}"
                                        Height="{TemplateBinding StatusDotSize}"
                                        Margin="{TemplateBinding StatusDotMargin}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="999"
                                        BorderThickness="2"
                                        BorderBrush="{DynamicResource Muzzle.Brush.Surface}"
                                        Background="{DynamicResource Muzzle.Brush.Success}"
                                        RenderTransformOrigin="0.5,0.5"
                                        Visibility="Collapsed">
                            <Grid x:Name="BusyBar" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Height="2" CornerRadius="1" VerticalAlignment="Center" Background="{DynamicResource Muzzle.Brush.Surface}" />
                            </Grid>
                        </mzc:SoftBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ColorIndex" Value="1">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Muzzle.Brush.SecondarySoft}" />
                            <Setter TargetName="InitialsText" Property="Foreground" Value="{DynamicResource Muzzle.Brush.SecondaryText}" />
                        </Trigger>
                        <Trigger Property="ColorIndex" Value="2">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Muzzle.Brush.MintSoft}" />
                            <Setter TargetName="InitialsText" Property="Foreground" Value="{DynamicResource Muzzle.Brush.MintText}" />
                        </Trigger>
                        <Trigger Property="ColorIndex" Value="3">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Muzzle.Brush.InfoSoft}" />
                            <Setter TargetName="InitialsText" Property="Foreground" Value="{DynamicResource Muzzle.Brush.InfoText}" />
                        </Trigger>
                        <Trigger Property="ColorIndex" Value="4">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Muzzle.Brush.WarningSoft}" />
                            <Setter TargetName="InitialsText" Property="Foreground" Value="{DynamicResource Muzzle.Brush.WarningText}" />
                        </Trigger>
                        <Trigger Property="ColorIndex" Value="5">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Muzzle.Brush.DangerSoft}" />
                            <Setter TargetName="InitialsText" Property="Foreground" Value="{DynamicResource Muzzle.Brush.DangerText}" />
                        </Trigger>
                        <Trigger Property="Initials" Value="">
                            <Setter TargetName="InitialsText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PersonGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsImageVisible" Value="True">
                            <Setter TargetName="Photo" Property="Visibility" Value="Visible" />
                            <Setter TargetName="InitialsText" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PersonGlyph" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="Status" Value="Online">
                            <Setter TargetName="PART_StatusDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Status" Value="Away">
                            <Setter TargetName="PART_StatusDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_StatusDot" Property="Background" Value="{DynamicResource Muzzle.Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Busy">
                            <Setter TargetName="PART_StatusDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_StatusDot" Property="Background" Value="{DynamicResource Muzzle.Brush.Error}" />
                            <Setter TargetName="BusyBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Status" Value="Offline">
                            <Setter TargetName="PART_StatusDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_StatusDot" Property="Background" Value="{DynamicResource Muzzle.Brush.ControlBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Avatar}" BasedOn="{StaticResource Muzzle.Avatar}" />

</ResourceDictionary>