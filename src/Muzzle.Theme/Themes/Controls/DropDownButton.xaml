<!--
    DropDownButton / SplitButton: Muzzle buttons with a chevron pill and a springy menu card.
    Muzzle.MenuItem: a flat rounded menu row (icon, header, gesture text) for drop-downs, tray menus and context cards.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.MenuItem" TargetType="{x:Type MenuItem}">
        <!-- A flat menu row with its own template: skip the stock theme style (and its ItemsControl-ancestor bindings). -->
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- Set here so the stock theme's ItemsControl-ancestor bindings never run (menus may live in a plain panel). -->
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="{TemplateBinding Background}"
                            mz:JellyBehavior.EnablePressSquish="True" mz:JellyBehavior.PressSquishScale="0.97">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" VerticalAlignment="Center" HorizontalAlignment="Left" ContentSource="Icon"
                                              TextElement.Foreground="{DynamicResource Muzzle.Brush.TextSecondary}" />
                            <mzc:MuzzleIcon x:Name="CheckMark" Kind="Check" IconSize="15" HorizontalAlignment="Left" Visibility="Collapsed"
                                            Foreground="{DynamicResource Muzzle.Brush.PrimaryText}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muzzle.Brush.TextTertiary}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Muzzle.Brush.PrimarySoft}" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Muzzle.Brush.PrimaryText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Muzzle.Brush.PrimarySoft}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.MenuSeparator" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Background="{DynamicResource Muzzle.Brush.SurfaceBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Muzzle.DropDownButton" TargetType="{x:Type mzc:DropDownButton}">
        <Setter Property="SegmentStyle" Value="{StaticResource Muzzle.Button}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:DropDownButton}">
                    <Grid>
                        <Button x:Name="PART_ToggleButton" Style="{TemplateBinding SegmentStyle}" Padding="16,8,12,8"
                                HorizontalContentAlignment="Stretch" mz:MuzzleAssist.Jelly="All">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <mzc:MuzzleIcon x:Name="Chevron" Margin="8,1,0,0" Kind="ChevronDown" IconSize="14" StrokeThickness="2.2" RenderTransformOrigin="0.5,0.5">
                                    <mzc:MuzzleIcon.RenderTransform>
                                        <RotateTransform />
                                    </mzc:MuzzleIcon.RenderTransform>
                                </mzc:MuzzleIcon>
                            </StackPanel>
                        </Button>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               StaysOpen="False"
                               Placement="{TemplateBinding Placement}"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Grid Margin="14,4,14,18">
                                <mzc:SoftBorder x:Name="PART_MenuCard"
                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                Padding="6"
                                                CornerRadius="12"
                                                Background="{DynamicResource Muzzle.Brush.Surface}"
                                                BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                                                BorderThickness="1"
                                                mz:FocusTrap.IsEnabled="True"
                                                Effect="{Binding Source={x:Static mz:ShadowDepth.Floating}, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding DropDownContent}"
                                                          Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Instance}}" />
                                        <ItemsControl ItemsSource="{Binding MenuItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      KeyboardNavigation.DirectionalNavigation="Cycle"
                                                      Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Inverted}}">
                                            <ItemsControl.Resources>
                                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Muzzle.MenuItem}" />
                                                <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource Muzzle.MenuSeparator}" />
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                    </Grid>
                                </mzc:SoftBorder>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.SplitButton" TargetType="{x:Type mzc:SplitButton}">
        <Setter Property="SegmentStyle" Value="{StaticResource Muzzle.Button}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:SplitButton}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PART_PrimaryButton" Style="{TemplateBinding SegmentStyle}"
                                    mz:MuzzleAssist.CornerRadius="10,4,4,10" mz:MuzzleAssist.Jelly="All"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Button x:Name="PART_ToggleButton" Margin="2,0,0,0" Padding="9,8" Style="{TemplateBinding SegmentStyle}"
                                    mz:MuzzleAssist.CornerRadius="4,10,10,4" mz:MuzzleAssist.Jelly="All"
                                    ToolTip="More options" AutomationProperties.Name="More options">
                                <mzc:MuzzleIcon x:Name="Chevron" Kind="ChevronDown" IconSize="14" StrokeThickness="2.2" RenderTransformOrigin="0.5,0.5">
                                    <mzc:MuzzleIcon.RenderTransform>
                                        <RotateTransform />
                                    </mzc:MuzzleIcon.RenderTransform>
                                </mzc:MuzzleIcon>
                            </Button>
                        </StackPanel>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               PopupAnimation="None"
                               StaysOpen="False"
                               Placement="{TemplateBinding Placement}"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Grid Margin="14,4,14,18">
                                <mzc:SoftBorder x:Name="PART_MenuCard"
                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                Padding="6"
                                                CornerRadius="12"
                                                Background="{DynamicResource Muzzle.Brush.Surface}"
                                                BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                                                BorderThickness="1"
                                                mz:FocusTrap.IsEnabled="True"
                                                Effect="{Binding Source={x:Static mz:ShadowDepth.Floating}, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}">
                                    <Grid>
                                        <ContentPresenter Content="{TemplateBinding DropDownContent}"
                                                          Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Instance}}" />
                                        <ItemsControl ItemsSource="{Binding MenuItems, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"
                                                      KeyboardNavigation.DirectionalNavigation="Cycle"
                                                      Visibility="{Binding DropDownContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Inverted}}">
                                            <ItemsControl.Resources>
                                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Muzzle.MenuItem}" />
                                                <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource Muzzle.MenuSeparator}" />
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                    </Grid>
                                </mzc:SoftBorder>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:DropDownButton}" BasedOn="{StaticResource Muzzle.DropDownButton}" />
    <Style TargetType="{x:Type mzc:SplitButton}" BasedOn="{StaticResource Muzzle.SplitButton}" />

</ResourceDictionary>