    <SolidColorBrush x:Key="Muzzle.Brush.Peach" Color="{StaticResource Muzzle.Color.Peach}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Danger" Color="{StaticResource Muzzle.Color.Danger}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.DangerSoft" Color="{StaticResource Muzzle.Color.DangerSoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.DangerText" Color="{StaticResource Muzzle.Color.DangerText}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.TextPrimary" Color="{StaticResource Muzzle.Color.TextPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.TextSecondary" Color="{StaticResource Muzzle.Color.TextSecondary}" po:Freeze="True" />
