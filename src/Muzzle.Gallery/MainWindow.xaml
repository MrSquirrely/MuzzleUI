<mz:MuzzleWindow x:Class="Muzzle.Gallery.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mz="http://schemas.muzzle.dev/wpf"
                 Title="Muzzle Gallery"
                 Icon="{StaticResource Gallery.PawIcon}"
                 Width="1280" Height="840"
                 MinWidth="960" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 NonClientAreaHeight="52"
                 mz:WindowStateSaver.Key="MainWindow">

    <mz:MuzzleWindow.NonClientAreaContent>
        <Grid Margin="8,0,4,0">
            <TextBox x:Name="SearchBox"
                     Width="280"
                     MinHeight="34"
                     Padding="12,6"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Background="{DynamicResource Muzzle.Brush.Surface}"
                     mz:MuzzleAssist.Placeholder="Search controls…  (Ctrl+F)"
                     AutomationProperties.Name="Search controls"
                     TextChanged="OnSearchChanged" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="PaletteButton" Width="34" Height="34" Margin="0,0,8,0" Style="{StaticResource Muzzle.Button.Icon}"
                        mz:MuzzleAssist.CornerRadius="999" ToolTip="Command palette (Ctrl+K)" AutomationProperties.Name="Command palette"
                        Click="OnPaletteButtonClick">
                    <mz:MuzzleIcon Kind="Command" IconSize="17" Foreground="{DynamicResource Muzzle.Brush.TextSecondary}" />
                </Button>
                <StackPanel x:Name="AccentSwatches" Margin="0,0,6,0" Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.Name="Accent colour">
                    <mz:AccentSwatch Accent="Coral" />
                    <mz:AccentSwatch Accent="Lavender" />
                    <mz:AccentSwatch Accent="Mint" />
                    <mz:AccentSwatch Accent="Peach" />
                </StackPanel>
                <mz:ThemeToggleButton x:Name="ThemeToggle" Margin="0,0,10,0" />
                <mz:ToggleSwitch x:Name="CalmSwitch"
                                 Margin="0,0,12,0"
                                 Content="Calm"
                                 FontSize="13"
                                 Foreground="{DynamicResource Muzzle.Brush.TextSecondary}"
                                 ToolTip="Turn jelly physics off everywhere"
                                 Checked="OnCalmChanged"
                                 Unchecked="OnCalmChanged" />
                <Button Padding="12,5"
                        MinHeight="32"
                        FontSize="13"
                        Content="Boop"
                        Style="{StaticResource Muzzle.Button.Secondary}"
                        ToolTip="Wobble the whole page"
                        Click="OnBoopClick" />
            </StackPanel>
        </Grid>
    </mz:MuzzleWindow.NonClientAreaContent>

    <Grid Margin="16,4,16,16" mz:Growl.GrowlParent="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <mz:NavigationView x:Name="NavList"
                           OpenPaneLength="232"
                           CompactPaneLength="64"
                           DisplayMemberPath="Title"
                           SelectionChanged="OnNavigationChanged"
                           AutomationProperties.Name="Gallery sections">
            <mz:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal">
                    <Image Width="30" Height="30" Source="{StaticResource Gallery.PawIcon}" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Muzzle" Style="{StaticResource Muzzle.Text.Title}" FontSize="19" LineHeight="23" />
                        <TextBlock Text="cozy jelly WPF theme" Style="{StaticResource Muzzle.Text.Caption}" TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>
            </mz:NavigationView.PaneHeader>
            <mz:NavigationView.PaneFooter>
                <TextBlock Margin="12,0" Style="{StaticResource Muzzle.Text.Caption}" TextWrapping="NoWrap">
                    <Run Text="v1.0 · .NET 9 / 10 · " /><Run Text="{DynamicResource Muzzle.ThemeName}" /><Run Text=" pastel" />
                </TextBlock>
            </mz:NavigationView.PaneFooter>
            <mz:NavigationView.Resources>
                <!-- Sidebar icons come from Muzzle's built-in icon pack. -->
                <DataTemplate DataType="{x:Type mz:MuzzleIconKind}">
                    <mz:MuzzleIcon Kind="{Binding}" IconSize="19" />
                </DataTemplate>
            </mz:NavigationView.Resources>
            <mz:NavigationView.ItemContainerStyle>
                <Style TargetType="mz:NavigationViewItem" BasedOn="{StaticResource Muzzle.NavigationViewItem}">
                    <Setter Property="Icon" Value="{Binding Icon}" />
                </Style>
            </mz:NavigationView.ItemContainerStyle>
        </mz:NavigationView>

        <mz:TransitioningContentControl x:Name="PageHost"
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Transition="SlideUp"
                                        SlideDistance="22"
                                        RenderTransformOrigin="0.5,0.5" />

        <!-- Ctrl+K anywhere in the window. -->
        <mz:CommandPalette x:Name="Palette"
                           Grid.ColumnSpan="2"
                           Margin="-16,-4,-16,-16"
                           Placeholder="Jump to a page, switch theme or accent, run an action…"
                           ItemInvoked="OnPaletteItemInvoked" />
    </Grid>
</mz:MuzzleWindow>