<!--
    Keycap / ShortcutBadge: tactile keyboard keys with a mechanical bottom lip; EmptyState: a centred placeholder.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <Style x:Key="Muzzle.Keycap" TargetType="{x:Type mzc:Keycap}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.ControlBorderStrong}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,1,6,0" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Keycap}">
                    <Border x:Name="PART_Cap"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,3">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding KeyText}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.ShortcutBadge" TargetType="{x:Type mzc:ShortcutBadge}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:ShortcutBadge}">
                    <ItemsControl ItemsSource="{TemplateBinding Keys}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <mzc:Keycap Margin="0,0,3,0" KeyText="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.EmptyState" TargetType="{x:Type mzc:EmptyState}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:EmptyState}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="16">
                        <StackPanel MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="72" Height="72"
                                    HorizontalAlignment="Center"
                                    CornerRadius="36"
                                    Background="{DynamicResource Muzzle.Brush.PrimarySoft}"
                                    mz:JellyBehavior.EntranceAnimation="PopIn"
                                    mz:JellyBehavior.EnableHoverBounce="True"
                                    mz:JellyBehavior.HoverScale="1.06">
                                <Grid>
                                    <mzc:MuzzleIcon x:Name="KindIcon" Kind="{TemplateBinding IconKind}" IconSize="32" Foreground="{DynamicResource Muzzle.Brush.PrimaryText}"
                                                    Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Inverted}}" />
                                    <ContentPresenter x:Name="CustomIcon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Icon}" TextElement.Foreground="{DynamicResource Muzzle.Brush.PrimaryText}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{TemplateBinding Title}" Style="{DynamicResource Muzzle.Text.Subtitle}" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{TemplateBinding Description}" Style="{DynamicResource Muzzle.Text.Secondary}" />
                            <ContentPresenter x:Name="Action" Margin="0,18,0,0" HorizontalAlignment="Center" Content="{TemplateBinding ActionContent}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="CustomIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Action" Property="Margin" Value="0,14,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Keycap}" BasedOn="{StaticResource Muzzle.Keycap}" />
    <Style TargetType="{x:Type mzc:ShortcutBadge}" BasedOn="{StaticResource Muzzle.ShortcutBadge}" />
    <Style TargetType="{x:Type mzc:EmptyState}" BasedOn="{StaticResource Muzzle.EmptyState}" />

</ResourceDictionary>