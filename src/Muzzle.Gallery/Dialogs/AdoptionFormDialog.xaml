<UserControl x:Class="Muzzle.Gallery.Dialogs.AdoptionFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             Width="400">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Muzzle.Brush.PrimarySoft}" mz:MuzzleAssist.Jelly="All">
                <Image Width="26" Height="26" Source="{StaticResource Gallery.PawIcon}" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Adopt a kitten" Style="{StaticResource Muzzle.Text.Title}" />
                <TextBlock Text="A form dialog that returns a typed result." Style="{StaticResource Muzzle.Text.Caption}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Margin="2,22,0,6" Text="Your name" Style="{StaticResource Muzzle.Text.Caption}" />
        <TextBox x:Name="NameBox" mz:MuzzleAssist.Placeholder="Who's taking them home?" AutomationProperties.Name="Your name" />

        <TextBlock Margin="2,14,0,6" Text="Kitten" Style="{StaticResource Muzzle.Text.Caption}" />
        <ComboBox x:Name="KittenBox" SelectedIndex="0" AutomationProperties.Name="Kitten">
            <ComboBoxItem Content="Mochi · calico, very chatty" />
            <ComboBoxItem Content="Biscuit · ginger, professional napper" />
            <ComboBoxItem Content="Tofu · white, suspicious of cucumbers" />
        </ComboBox>

        <mz:ToggleSwitch x:Name="IndoorSwitch" Margin="0,16,0,0" Content="Indoor-only home" IsChecked="True" />

        <StackPanel Margin="0,26,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="Cancel" Style="{StaticResource Muzzle.Button.Ghost}" IsCancel="True"
                    Command="{x:Static mz:Dialog.CloseCommand}" />
            <Button Margin="10,0,0,0" Content="Adopt" Style="{StaticResource Muzzle.Button.Primary}" IsDefault="True" Click="OnAdoptClick" />
        </StackPanel>
    </StackPanel>
</UserControl>