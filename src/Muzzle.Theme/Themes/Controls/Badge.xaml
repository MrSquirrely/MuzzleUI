<!--
    Badge: a pastel pill (or dot) ringed in white at the content's top-right corner.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <Style x:Key="Muzzle.Badge" TargetType="{x:Type mzc:Badge}">
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="BadgeForeground" Value="{DynamicResource Muzzle.Brush.OnPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:Badge}">
                    <Grid>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="PART_Pill"
                                MinWidth="20" Height="20"
                                Margin="{TemplateBinding BadgeMargin}"
                                Padding="6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Muzzle.Brush.Surface}"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5">
                            <TextBlock x:Name="Label"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding DisplayText}"
                                       Foreground="{TemplateBinding BadgeForeground}"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBadgeVisible" Value="True">
                            <Setter TargetName="PART_Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDot" Value="True">
                            <Setter TargetName="PART_Pill" Property="MinWidth" Value="0" />
                            <Setter TargetName="PART_Pill" Property="Width" Value="12" />
                            <Setter TargetName="PART_Pill" Property="Height" Value="12" />
                            <Setter TargetName="PART_Pill" Property="Padding" Value="0" />
                            <Setter TargetName="PART_Pill" Property="CornerRadius" Value="6" />
                            <Setter TargetName="PART_Pill" Property="Margin" Value="0,-3,-3,0" />
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Secondary">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Secondary}" />
                            <Setter Property="BadgeForeground" Value="{DynamicResource Muzzle.Brush.OnStatus}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Info">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Info}" />
                            <Setter Property="BadgeForeground" Value="{DynamicResource Muzzle.Brush.OnStatus}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Success}" />
                            <Setter Property="BadgeForeground" Value="{DynamicResource Muzzle.Brush.OnStatus}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Warning}" />
                            <Setter Property="BadgeForeground" Value="{DynamicResource Muzzle.Brush.OnStatus}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.Error}" />
                            <Setter Property="BadgeForeground" Value="{DynamicResource Muzzle.Brush.OnStatus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:Badge}" BasedOn="{StaticResource Muzzle.Badge}" />

</ResourceDictionary>