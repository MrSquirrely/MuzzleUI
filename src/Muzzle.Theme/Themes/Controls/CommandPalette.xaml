<!--
    CommandPalette: a softly dimmed backdrop with a floating search card (search field, ranked results with icons,
    category badges and keycap shortcuts, an empty state and a keyboard-hint footer).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ListBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="Muzzle.CommandPalette.ItemTemplate" DataType="{x:Type mzc:CommandPaletteItem}">
        <Grid MinHeight="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" Margin="0,0,12,0" CornerRadius="9" Background="{DynamicResource Muzzle.Brush.CanvasAlt}">
                <mzc:MuzzleIcon Kind="{Binding Icon}" IconSize="17" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="Normal" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Muzzle.Brush.TextSecondary}"
                           Visibility="{Binding Description, Converter={x:Static mzv:NullToVisibilityConverter.Instance}}" />
            </StackPanel>
            <Border Grid.Column="2" Margin="10,0,0,0" Padding="8,1" VerticalAlignment="Center" CornerRadius="999"
                    Background="{DynamicResource Muzzle.Brush.SecondarySoft}"
                    Visibility="{Binding Category, Converter={x:Static mzv:NullToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.SecondaryText}" />
            </Border>
            <mzc:ShortcutBadge Grid.Column="3" Margin="10,0,0,0" Shortcut="{Binding Shortcut}"
                               Visibility="{Binding Shortcut, Converter={x:Static mzv:NullToVisibilityConverter.Instance}}" />
        </Grid>
    </DataTemplate>

    <Style x:Key="Muzzle.CommandPalette.SearchBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.CommandPalette" TargetType="{x:Type mzc:CommandPalette}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Panel.ZIndex" Value="1000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:CommandPalette}">
                    <Grid>
                        <Border x:Name="PART_Backdrop" Background="{DynamicResource Muzzle.Brush.Backdrop}" CornerRadius="16" />
                        <mzc:SoftBorder x:Name="PART_Card"
                                        Width="580"
                                        Margin="16,56,16,16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        CornerRadius="16"
                                        Background="{DynamicResource Muzzle.Brush.Surface}"
                                        BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                                        BorderThickness="1"
                                        mz:FocusTrap.IsEnabled="True"
                                        Effect="{Binding Source={x:Static mz:ShadowDepth.Floating}, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="18,14,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <mzc:MuzzleIcon Kind="Search" IconSize="19" Foreground="{DynamicResource Muzzle.Brush.PrimaryText}" />
                                    <TextBox x:Name="PART_SearchBox"
                                             Grid.Column="1"
                                             Margin="12,0"
                                             Style="{StaticResource Muzzle.CommandPalette.SearchBox}"
                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{DynamicResource Muzzle.String.CommandPalette.Search}" />
                                    <TextBlock Grid.Column="1" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="16"
                                               Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Muzzle.Brush.TextTertiary}"
                                               Visibility="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static mzv:NullToVisibilityConverter.Inverted}}" />
                                    <mzc:Keycap Grid.Column="2" KeyText="Esc" />
                                </Grid>
                                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Muzzle.Brush.SurfaceBorder}" />
                                <Border DockPanel.Dock="Bottom" Padding="16,9" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Muzzle.Brush.SurfaceBorder}">
                                    <StackPanel Orientation="Horizontal" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Muzzle.Brush.TextTertiary}">
                                        <mzc:Keycap KeyText="↑" />
                                        <mzc:Keycap Margin="3,0,6,0" KeyText="↓" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Muzzle.String.CommandPalette.ToNavigate}" />
                                        <mzc:Keycap Margin="16,0,6,0" KeyText="Enter" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Muzzle.String.CommandPalette.ToRun}" />
                                        <mzc:Keycap Margin="16,0,6,0" KeyText="Esc" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Muzzle.String.CommandPalette.ToClose}" />
                                    </StackPanel>
                                </Border>
                                <Grid MaxHeight="380">
                                    <ListBox x:Name="PART_Results"
                                             Padding="8"
                                             Focusable="False"
                                             ItemTemplate="{StaticResource Muzzle.CommandPalette.ItemTemplate}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             mz:ScrollViewerAssist.EnableSmoothScroll="True">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Muzzle.ListBoxItem}">
                                                <Setter Property="Padding" Value="8,6" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <mzc:EmptyState x:Name="NoResults" Padding="16,22" IconKind="Search" Title="{DynamicResource Muzzle.String.CommandPalette.NoMatches}"
                                                    Description="{DynamicResource Muzzle.String.CommandPalette.NoMatchesHint}"
                                                    Visibility="{TemplateBinding HasResults, Converter={x:Static mzv:BoolToVisibilityConverter.Inverted}}" />
                                </Grid>
                            </DockPanel>
                        </mzc:SoftBorder>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:CommandPalette}" BasedOn="{StaticResource Muzzle.CommandPalette}" />

</ResourceDictionary>