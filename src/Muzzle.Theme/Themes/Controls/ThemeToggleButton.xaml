<!--
    ThemeToggleButton: a round ghost icon button (sun / moon / monitor) that cycles Light, Dark and System.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.ThemeToggleButton" TargetType="{x:Type mzc:ThemeToggleButton}" BasedOn="{StaticResource Muzzle.Button.Icon}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="999" />
        <Setter Property="mz:MuzzleAssist.Jelly" Value="All" />
    </Style>

    <Style TargetType="{x:Type mzc:ThemeToggleButton}" BasedOn="{StaticResource Muzzle.ThemeToggleButton}" />

</ResourceDictionary>