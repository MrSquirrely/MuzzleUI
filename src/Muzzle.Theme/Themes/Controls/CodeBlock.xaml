<!--
    CodeBlock: a rounded monospace surface with optional line numbers, a language badge and a floating Copy button that
    morphs into a bouncing mint "Copied!". CopyableText: inline text with a tiny copy button.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Button.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The copied state: a mint check that pops in. -->
    <Storyboard x:Key="Muzzle.CopyButton.Pop">
        <DoubleAnimation Storyboard.TargetName="CopiedFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.5" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
        <DoubleAnimation Storyboard.TargetName="CopiedFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.5" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
    </Storyboard>

    <Style x:Key="Muzzle.CodeBlock" TargetType="{x:Type mzc:CodeBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.CanvasAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.SurfaceBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Muzzle.FontFamily.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:CodeBlock}">
                    <mzc:SoftBorder Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                                          mz:ScrollViewerAssist.EnableShiftHorizontalScroll="True">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PART_LineNumbers"
                                               Margin="0,0,14,0"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource Muzzle.Brush.TextTertiary}"
                                               Visibility="{TemplateBinding ShowLineNumbers, Converter={x:Static mzv:BoolToVisibilityConverter.Instance}}" />
                                    <TextBlock x:Name="PART_Code" Grid.Column="1" Margin="0,0,96,0" TextWrapping="NoWrap" />
                                </Grid>
                            </ScrollViewer>
                            <!-- The floating badge + Copy cluster sits on a patch of the block's own colour so long lines don't show through. -->
                            <Border Margin="0,4,4,0" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10"
                                    Background="{TemplateBinding Background}">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                <Border x:Name="LanguageBadge" Margin="0,0,6,0" VerticalAlignment="Center" Padding="7,1" CornerRadius="999"
                                        Background="{DynamicResource Muzzle.Brush.SecondarySoft}">
                                    <TextBlock Text="{TemplateBinding Language}" FontFamily="{DynamicResource Muzzle.FontFamily}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muzzle.Brush.SecondaryText}" />
                                </Border>
                                <Button x:Name="PART_CopyButton"
                                        MinHeight="28"
                                        Padding="10,3"
                                        FontFamily="{DynamicResource Muzzle.FontFamily}"
                                        FontSize="12"
                                        Style="{StaticResource Muzzle.Button}"
                                        Visibility="{TemplateBinding ShowCopyButton, Converter={x:Static mzv:BoolToVisibilityConverter.Instance}}"
                                        ToolTip="{DynamicResource Muzzle.String.CodeBlock.CopyToClipboard}"
                                        AutomationProperties.Name="{DynamicResource Muzzle.String.CodeBlock.CopyCode}">
                                    <Grid>
                                        <StackPanel x:Name="CopyFace" Orientation="Horizontal">
                                            <mzc:MuzzleIcon Kind="Copy" IconSize="14" />
                                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Muzzle.String.CodeBlock.Copy}" />
                                        </StackPanel>
                                        <StackPanel x:Name="CopiedFace" Orientation="Horizontal" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                            <StackPanel.RenderTransform>
                                                <ScaleTransform />
                                            </StackPanel.RenderTransform>
                                            <mzc:MuzzleIcon Kind="Check" IconSize="14" StrokeThickness="2.4" />
                                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Muzzle.String.CodeBlock.Copied}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            </Border>
                        </Grid>
                    </mzc:SoftBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Language" Value="">
                            <Setter TargetName="LanguageBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowCopyButton" Value="False">
                            <Setter TargetName="PART_Code" Property="Margin" Value="0,0,60,0" />
                        </Trigger>
                        <Trigger Property="IsCopied" Value="True">
                            <Setter TargetName="CopyFace" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CopiedFace" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_CopyButton" Property="Background" Value="{DynamicResource Muzzle.Brush.MintSoft}" />
                            <Setter TargetName="PART_CopyButton" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Mint}" />
                            <Setter TargetName="PART_CopyButton" Property="Foreground" Value="{DynamicResource Muzzle.Brush.MintText}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Muzzle.CopyButton.Pop}" />
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.CopyableText" TargetType="{x:Type mzc:CopyableText}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.CanvasAlt}" />
        <Setter Property="FontFamily" Value="{DynamicResource Muzzle.FontFamily.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,4,4,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:CopyableText}">
                    <Border Padding="{TemplateBinding Padding}" CornerRadius="8" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{TemplateBinding Text}" />
                            <Button x:Name="PART_CopyButton"
                                    Width="26" Height="26"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource Muzzle.Button.Icon}"
                                    mz:MuzzleAssist.CornerRadius="999"
                                    ToolTip="{DynamicResource Muzzle.String.CodeBlock.Copy}"
                                    AutomationProperties.Name="{DynamicResource Muzzle.String.CodeBlock.Copy}">
                                <Grid>
                                    <mzc:MuzzleIcon x:Name="CopyIcon" Kind="Copy" IconSize="14" Foreground="{DynamicResource Muzzle.Brush.TextSecondary}" />
                                    <mzc:MuzzleIcon x:Name="CopiedFace" Kind="Check" IconSize="14" StrokeThickness="2.4" Visibility="Collapsed"
                                                    Foreground="{DynamicResource Muzzle.Brush.MintText}" RenderTransformOrigin="0.5,0.5">
                                        <mzc:MuzzleIcon.RenderTransform>
                                            <ScaleTransform />
                                        </mzc:MuzzleIcon.RenderTransform>
                                    </mzc:MuzzleIcon>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCopied" Value="True">
                            <Setter TargetName="CopyIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CopiedFace" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_CopyButton" Property="Background" Value="{DynamicResource Muzzle.Brush.MintSoft}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Muzzle.CopyButton.Pop}" />
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:CodeBlock}" BasedOn="{StaticResource Muzzle.CodeBlock}" />
    <Style TargetType="{x:Type mzc:CopyableText}" BasedOn="{StaticResource Muzzle.CopyableText}" />

</ResourceDictionary>