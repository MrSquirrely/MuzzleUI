<!--
    CheckBox: the box fills with blush and the checkmark (or indeterminate dash) springs in with an elastic overshoot.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.CheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.ControlBorderStrong}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="BoxHost" Width="20" Height="20" VerticalAlignment="Center"
                              mz:MuzzleAssist.Jelly="Hover, Press, Toggle">
                            <Border x:Name="Box"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}" />
                            <Border x:Name="Fill"
                                    Background="{DynamicResource Muzzle.Brush.Primary}"
                                    CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                                </Border.RenderTransform>
                            </Border>
                            <Path x:Name="Check"
                                  Width="20" Height="20"
                                  Data="M 5,10.4 L 8.6,13.8 L 15.2,6.6"
                                  Stroke="{DynamicResource Muzzle.Brush.Surface}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="0" />
                                </Path.RenderTransform>
                            </Path>
                            <Rectangle x:Name="Dash"
                                       Width="10" Height="2.4" RadiusX="1.2" RadiusY="1.2"
                                       Fill="{DynamicResource Muzzle.Brush.Surface}"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="0" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ContentPresenter x:Name="Presenter"
                                          Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.38" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.38" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0" To="1" BeginTime="0:0:0.04" Duration="0:0:0.65" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0" To="1" BeginTime="0:0:0.04" Duration="0:0:0.65" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.5" Duration="0:0:0.2" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.5" Duration="0:0:0.2" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.38" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.38" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0" To="1" BeginTime="0:0:0.04" Duration="0:0:0.65" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                        <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0" To="1" BeginTime="0:0:0.04" Duration="0:0:0.65" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                        <DoubleAnimation Storyboard.TargetName="Dash" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource Muzzle.CheckBox}" />

</ResourceDictionary>