<!--
    BreadcrumbBar: segments grow 1.04x on hover; chevrons pop in when a segment appears and nudge forward on hover.
    The last segment is the current location (bold, blush-tinted). Overflow is handled by BreadcrumbPanel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.BreadcrumbItem" TargetType="{x:Type mzc:BreadcrumbItem}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Muzzle.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:BreadcrumbItem}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Path x:Name="Chevron"
                              Width="6" Height="10"
                              Margin="4,0"
                              VerticalAlignment="Center"
                              Data="M 1,1 L 5,5 L 1,9"
                              Stroke="{DynamicResource Muzzle.Brush.TextTertiary}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             From="0.3" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             From="0.3" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                        <Grid x:Name="Segment" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border x:Name="Hover" CornerRadius="9" Background="{DynamicResource Muzzle.Brush.HoverTint}" Opacity="0" />
                            <ContentPresenter x:Name="Label"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirst" Value="True">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsLast" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.PrimaryText}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Segment" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.04" Duration="0:0:0.35" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Segment" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.04" Duration="0:0:0.35" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="2" Duration="0:0:0.35" EasingFunction="{StaticResource Muzzle.Ease.BackStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Segment" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Muzzle.Ease.JellySoft}" />
                                        <DoubleAnimation Storyboard.TargetName="Segment" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Muzzle.Ease.JellySoft}" />
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.BackSoft}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Muzzle.Brush.PrimarySoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.BreadcrumbBar" TargetType="{x:Type mzc:BreadcrumbBar}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextSecondary}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <mzc:BreadcrumbPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:BreadcrumbBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:BreadcrumbBar}" BasedOn="{StaticResource Muzzle.BreadcrumbBar}" />
    <Style TargetType="{x:Type mzc:BreadcrumbItem}" BasedOn="{StaticResource Muzzle.BreadcrumbItem}" />

</ResourceDictionary>