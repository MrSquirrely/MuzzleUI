<!--
    Muzzle: a cozy, pastel, jelly-physics theme for WPF.

    Drop it into any app with a single merged dictionary:

        <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/Muzzle.Theme;component/Themes/Muzzle.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Application.Resources>

    Switch themes at runtime with MuzzleThemeManager.ApplyTheme(MuzzleTheme.Dark / Light / System).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- Raw pastel ramp (Muzzle.Palette.*), theme-independent. -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Tokens/Colors.xaml" />
        <!-- The palette slot: Muzzle.Light.xaml or Muzzle.Dark.xaml. MuzzleThemeManager swaps this entry at runtime. -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Muzzle.Light.xaml" />
        <!-- The accent slot, always right after the palette so its Primary / Secondary / Tertiary keys win.
             MuzzleThemeManager.ApplyAccent swaps it (and keeps its Light / Dark variant in step with the palette). -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Accents/Muzzle.Accent.Coral.Light.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Tokens/Typography.xaml" />
        <!-- Built-in text (Muzzle.String.*); override a key in the app's resources to translate it. -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Tokens/Strings.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Icons/MuzzleIcons.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />

        <!-- Controls -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/FocusVisual.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/MuzzleIcon.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Button.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/TextBox.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/CheckBox.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/RadioButton.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ToggleSwitch.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ComboBox.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Slider.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ProgressBar.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/TabControl.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Expander.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ScrollViewer.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ListBox.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Card.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/MuzzleWindow.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/PropertyGrid.xaml" />

        <!-- Overlays & notifications -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Growl.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Dialog.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Drawer.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Menu.xaml" />

        <!-- Navigation & layout -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/NavigationView.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/BreadcrumbBar.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Pagination.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/TransitioningContentControl.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/StepBar.xaml" />

        <!-- Inputs & pickers -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/NumericUpDown.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/TagInput.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/SearchBar.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ColorPicker.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/DatePicker.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/TimePicker.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Rating.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ColorPickerDropDown.xaml" />

        <!-- Feedback & status -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Badge.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Skeleton.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/LoadingSpinner.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/InfoBar.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Popover.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ThemeToggleButton.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/AccentSwatch.xaml" />

        <!-- Data & media -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/DataGrid.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Avatar.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Carousel.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/TreeView.xaml" />

        <!-- Desktop controls -->
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/Keycap.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/CodeBlock.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/RangeSlider.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/DropDownButton.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/CommandPalette.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>