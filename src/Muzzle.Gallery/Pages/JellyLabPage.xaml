<UserControl x:Class="Muzzle.Gallery.Pages.JellyLabPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mz="http://schemas.muzzle.dev/wpf"
             xmlns:local="clr-namespace:Muzzle.Gallery"
             xmlns:controls="clr-namespace:Muzzle.Gallery.Controls">
    <ScrollViewer Style="{StaticResource Gallery.PageScroller}">
        <StackPanel Margin="4,4,20,28">
            <TextBlock Text="Jelly lab" Style="{StaticResource Gallery.PageHeader}" />
            <TextBlock Style="{StaticResource Gallery.PageLead}"
                       Text="Poke the physics. MuzzleAssist.JellyIntensity inherits down the tree, so the slider below retunes every control in the app at once." />

            <mz:Card>
                <StackPanel>
                    <TextBlock Text="Global jelly intensity" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Bound to the window's mz:MuzzleAssist.JellyIntensity. 0 is calm, 1 is the default, 3 is pure wobble." Style="{StaticResource Gallery.SectionLead}" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="48" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold"
                                   Text="{Binding Value, ElementName=IntensitySlider, StringFormat={}{0:0.0}×}" />
                        <Slider x:Name="IntensitySlider"
                                Minimum="0" Maximum="3" SmallChange="0.1" LargeChange="0.5"
                                TickPlacement="BottomRight" TickFrequency="0.5"
                                Value="{Binding (mz:MuzzleAssist.JellyIntensity), RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                                AutomationProperties.Name="Jelly intensity" />
                    </DockPanel>
                </StackPanel>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Test pads" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="Plain Borders with mz:MuzzleAssist.Jelly set to different modes. Hover, press and hold, release." Style="{StaticResource Gallery.SectionLead}" />
                    <UniformGrid Columns="4">
                        <Border Margin="0,0,14,0" Height="110" CornerRadius="18" Background="{DynamicResource Muzzle.Brush.PrimarySoft}" mz:MuzzleAssist.Jelly="Hover">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Text="Hover" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.PrimaryText}" />
                                <TextBlock HorizontalAlignment="Center" Text="grows 1.03×" Style="{StaticResource Muzzle.Text.Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,14,0" Height="110" CornerRadius="18" Background="{DynamicResource Muzzle.Brush.SecondarySoft}" mz:MuzzleAssist.Jelly="Press">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Text="Press" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.SecondaryText}" />
                                <TextBlock HorizontalAlignment="Center" Text="0.94 × 0.92 squish" Style="{StaticResource Muzzle.Text.Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,14,0" Height="110" CornerRadius="18" Background="{DynamicResource Muzzle.Brush.MintSoft}" mz:MuzzleAssist.Jelly="Hover, Press">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Text="Hover, Press" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.MintText}" />
                                <TextBlock HorizontalAlignment="Center" Text="the button feel" Style="{StaticResource Muzzle.Text.Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Height="110" CornerRadius="18" Background="{DynamicResource Muzzle.Brush.CanvasAlt}" mz:MuzzleAssist.Jelly="Hover, Press" mz:MuzzleAssist.JellyIntensity="3">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Text="Intensity 3" FontWeight="SemiBold" />
                                <TextBlock HorizontalAlignment="Center" Text="local override" Style="{StaticResource Muzzle.Text.Caption}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Reusable storyboards" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="From JellyEasings.xaml, triggered purely in XAML (no code-behind). Click each blob." Style="{StaticResource Gallery.SectionLead}" />
                    <WrapPanel>
                        <Border Width="120" Height="84" Margin="0,0,14,0" CornerRadius="42" Background="{DynamicResource Muzzle.Brush.Primary}" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard Storyboard="{StaticResource Muzzle.Storyboard.Boop}" />
                                </EventTrigger>
                            </Border.Triggers>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Boop" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.OnPrimary}" />
                        </Border>
                        <Border Width="120" Height="84" Margin="0,0,14,0" CornerRadius="42" Background="{DynamicResource Muzzle.Brush.Secondary}" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard Storyboard="{StaticResource Muzzle.Storyboard.PopIn}" />
                                </EventTrigger>
                            </Border.Triggers>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="PopIn" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.SecondaryText}" />
                        </Border>
                        <Border Width="120" Height="84" CornerRadius="42" Background="{DynamicResource Muzzle.Brush.Mint}" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                    <BeginStoryboard Storyboard="{StaticResource Muzzle.Storyboard.Squish}" />
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard Storyboard="{StaticResource Muzzle.Storyboard.Release}" />
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard Storyboard="{StaticResource Muzzle.Storyboard.Settle}" />
                                </EventTrigger>
                            </Border.Triggers>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Squish / Release" FontWeight="SemiBold" Foreground="{DynamicResource Muzzle.Brush.MintText}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Content="Race the easings" Style="{StaticResource Muzzle.Button.Pill}" Click="OnRaceClick" />
                        <TextBlock Text="Easing playground" Style="{StaticResource Gallery.SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Each bean runs the same distance with a shared easing resource (Muzzle.Ease.*)." Style="{StaticResource Gallery.SectionLead}" />
                    <ItemsControl x:Name="EasingLanes" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" Style="{StaticResource Muzzle.Text.Code}" />
                                    <Border Grid.Column="1" Height="30" CornerRadius="15" Background="{DynamicResource Muzzle.Brush.CanvasAlt}" ClipToBounds="False">
                                        <Border x:Name="Bean" Width="44" Height="22" Margin="4,0" HorizontalAlignment="Left" CornerRadius="11"
                                                Background="{Binding Brush}" Tag="{Binding Key}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </mz:Card>

            <mz:Card Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Snippet" Style="{StaticResource Gallery.SectionTitle}" />
                    <TextBlock Text="The jelly engine respects the Windows 'Show animations' setting automatically." Style="{StaticResource Gallery.SectionLead}" />
                    <controls:SnippetView Code="{x:Static local:Snippets.Jelly}" />
                </StackPanel>
            </mz:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>