<!--
    InfoBar: pastel-tinted rounded banner with a semantic icon pill, title + message, optional action and close button.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <BooleanToVisibilityConverter x:Key="Muzzle.InfoBar.BoolToVisibility" />

    <Style x:Key="Muzzle.InfoBar" TargetType="{x:Type mzc:InfoBar}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.InfoSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Info}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,12,10,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:InfoBar}">
                    <mzc:SoftBorder Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconPill"
                                    Width="28" Height="28"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="14"
                                    Background="{TemplateBinding BorderBrush}"
                                    Visibility="{Binding IsIconVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Muzzle.InfoBar.BoolToVisibility}}"
                                    mz:MuzzleAssist.Jelly="Hover">
                                <Path x:Name="Icon"
                                      Width="16" Height="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 8,7.2 V 12 M 8,4 V 4.1"
                                      Stroke="{DynamicResource Muzzle.Brush.OnStatus}"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Margin="0,0,0,2" Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Muzzle.Brush.TextSecondary}" />
                                <ContentPresenter x:Name="Extra" Margin="0,8,0,0" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding ActionContent}" />
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="3"
                                    Width="28" Height="28"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{DynamicResource Muzzle.Button.Icon}"
                                    mz:MuzzleAssist.CornerRadius="14"
                                    Visibility="{Binding IsClosable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Muzzle.InfoBar.BoolToVisibility}}"
                                    ToolTip="{DynamicResource Muzzle.String.InfoBar.Dismiss}"
                                    AutomationProperties.Name="{DynamicResource Muzzle.String.InfoBar.Dismiss}">
                                <Path Width="10" Height="10" Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{DynamicResource Muzzle.Brush.TextSecondary}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>
                    </mzc:SoftBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Extra" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.SuccessSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Success}" />
                            <Setter TargetName="Icon" Property="Data" Value="M 3,8.6 L 6.6,12 L 13,4.6" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.WarningSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Warning}" />
                            <Setter TargetName="Icon" Property="Data" Value="M 8,3.5 V 9.4 M 8,12.4 V 12.5" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.ErrorSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Error}" />
                            <Setter TargetName="Icon" Property="Data" Value="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:InfoBar}" BasedOn="{StaticResource Muzzle.InfoBar}" />

</ResourceDictionary>