<!--
    SearchBar: pill search field with a magnifier, a bouncy clear button that pops in when there is text,
    and a springy suggestion dropdown.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Controls/ListBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.SearchBar.SuggestionItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Muzzle.ListBoxItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="Muzzle.SearchBar" TargetType="{x:Type mzc:SearchBar}">
        <Setter Property="Foreground" Value="{DynamicResource Muzzle.Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Muzzle.Brush.ControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,8,4,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Muzzle.Brush.PrimaryText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="mz:MuzzleAssist.CornerRadius" Value="999" />
        <Setter Property="mz:MuzzleAssist.Placeholder" Value="Search…" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:SearchBar}">
                    <Grid x:Name="Root" mz:MuzzleAssist.Jelly="Focus">
                        <mzc:SoftBorder x:Name="FocusRing" Opacity="0" BorderThickness="3" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource Muzzle.Brush.FocusRing}"
                                        CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius, Converter={x:Static mzv:CornerRadiusOffsetConverter.Instance}, ConverterParameter=3}" />
                        <mzc:SoftBorder x:Name="Body"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding mz:MuzzleAssist.CornerRadius}" />
                        <Grid Margin="{TemplateBinding BorderThickness}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Magnifier"
                                  Width="15" Height="15"
                                  Margin="14,0,6,0"
                                  VerticalAlignment="Center"
                                  Data="M 6.5,1.5 A 5,5 0 1 1 6.49,1.5 Z M 10.2,10.2 L 14,14"
                                  Stroke="{DynamicResource Muzzle.Brush.TextTertiary}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock x:Name="Placeholder"
                                       Grid.Column="1"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Text="{TemplateBinding mz:MuzzleAssist.Placeholder}"
                                       Foreground="{DynamicResource Muzzle.Brush.TextTertiary}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <Button x:Name="ClearButton"
                                    Grid.Column="2"
                                    Width="24" Height="24"
                                    Margin="0,0,8,0"
                                    Style="{DynamicResource Muzzle.SquishPillButton}"
                                    Command="{x:Static mzc:SearchBar.ClearCommand}"
                                    ToolTip="Clear"
                                    AutomationProperties.Name="Clear search"
                                    RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform />
                                </Button.RenderTransform>
                                <Path Width="8" Height="8" Data="M 1,1 L 7,7 M 7,1 L 1,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               HorizontalOffset="-12"
                               VerticalOffset="2"
                               PopupAnimation="None"
                               IsOpen="{Binding IsSuggestionListOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid x:Name="DropDownHost" Margin="12,4,12,20" MinWidth="{Binding ActualWidth, ElementName=Root}" RenderTransformOrigin="0.5,0">
                                <Grid.RenderTransform>
                                    <ScaleTransform />
                                </Grid.RenderTransform>
                                <Border Background="{DynamicResource Muzzle.Brush.Surface}" BorderBrush="{DynamicResource Muzzle.Brush.SurfaceRim}"
                                        BorderThickness="1" CornerRadius="14" Effect="{DynamicResource Muzzle.Shadow.Floating}" />
                                <ListBox x:Name="PART_SuggestionList"
                                         Margin="6"
                                         MaxHeight="260"
                                         Focusable="False"
                                         ItemContainerStyle="{StaticResource Muzzle.SearchBar.SuggestionItem}"
                                         AutomationProperties.Name="Suggestions" />
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ClearButton" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="ClearButton" Property="IsEnabled" Value="False" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ClearButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0" Duration="0:0:0.18" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                        <DoubleAnimation Storyboard.TargetName="ClearButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="0:0:0.18" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ClearButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                        <DoubleAnimation Storyboard.TargetName="ClearButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSuggestionListOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DropDownHost" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="DropDownHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.82" To="1" Duration="0:0:0.55" EasingFunction="{StaticResource Muzzle.Ease.JellySoft}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
                            <Setter TargetName="Magnifier" Property="Stroke" Value="{DynamicResource Muzzle.Brush.PrimaryText}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <ThicknessAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Margin" From="0" To="-3" Duration="0:0:0.5"
                                                            EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <ThicknessAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Margin" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:SearchBar}" BasedOn="{StaticResource Muzzle.SearchBar}" />

</ResourceDictionary>