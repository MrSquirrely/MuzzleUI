    <SolidColorBrush x:Key="Muzzle.Brush.FocusRing" Color="{StaticResource Muzzle.Color.FocusRing}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.ScrollThumb" Color="{StaticResource Muzzle.Color.ScrollThumb}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.ScrollThumbHover" Color="{StaticResource Muzzle.Color.ScrollThumbHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SwatchOutline" Color="{StaticResource Muzzle.Color.SwatchOutline}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Shimmer" Color="{StaticResource Muzzle.Color.Shimmer}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.CaptionCloseHover" Color="{StaticResource Muzzle.Color.CaptionCloseHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.CaptionCloseGlyph" Color="{StaticResource Muzzle.Color.CaptionCloseGlyph}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.TooltipBackground" Color="{StaticResource Muzzle.Color.TooltipBackground}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.TooltipForeground" Color="{StaticResource Muzzle.Color.TooltipForeground}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Info" Color="{StaticResource Muzzle.Color.Info}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.InfoSoft" Color="{StaticResource Muzzle.Color.InfoSoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.InfoText" Color="{StaticResource Muzzle.Color.InfoText}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Success" Color="{StaticResource Muzzle.Color.Success}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SuccessSoft" Color="{StaticResource Muzzle.Color.SuccessSoft}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SuccessText" Color="{StaticResource Muzzle.Color.SuccessText}" po:Freeze="True" />
