<!--
    RangeSlider: a pastel track with an accent range bar between two squishy thumbs that grow on hover and drag.
    PasswordStrengthMeter: four rounded segments plus a label. GridSplitter: a centred pill grab handle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mz="clr-namespace:Muzzle.Theme"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls"
                    xmlns:mzv="clr-namespace:Muzzle.Theme.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Muzzle.RangeSlider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Ellipse x:Name="Halo" Margin="-7" Fill="{DynamicResource Muzzle.Brush.FocusRing}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Body"
                                 Fill="{DynamicResource Muzzle.Brush.Thumb}"
                                 Stroke="{DynamicResource Muzzle.Brush.Primary}"
                                 StrokeThickness="2.5"
                                 RenderTransformOrigin="0.5,0.5"
                                 Effect="{Binding Source={x:Static mz:ShadowDepth.Soft}, Converter={x:Static mzv:ShadowDepthToEffectConverter.Instance}}">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.18" Duration="0:0:0.35" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.18" Duration="0:0:0.35" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource Muzzle.Ease.JellySoft}" />
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.5" EasingFunction="{StaticResource Muzzle.Ease.JellySoft}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Body" Property="Stroke" Value="{DynamicResource Muzzle.Brush.PrimaryPressed}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.3" Duration="0:0:0.3" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.22" Duration="0:0:0.3" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.4" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.55" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.55" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.6" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.6" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.8" />
                            <Setter TargetName="Halo" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.RangeSlider" TargetType="{x:Type mzc:RangeSlider}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:RangeSlider}">
                    <Grid Background="Transparent">
                        <Border Height="6" Margin="10,0" VerticalAlignment="Center" CornerRadius="3" Background="{DynamicResource Muzzle.Brush.Track}" />
                        <Canvas x:Name="PART_Canvas" Background="Transparent" ClipToBounds="False">
                            <Border x:Name="PART_Range" Height="6" CornerRadius="3" Background="{DynamicResource Muzzle.Brush.Primary}" />
                            <Thumb x:Name="PART_LowerThumb" Style="{StaticResource Muzzle.RangeSlider.Thumb}" AutomationProperties.Name="Lower value" />
                            <Thumb x:Name="PART_UpperThumb" Style="{StaticResource Muzzle.RangeSlider.Thumb}" AutomationProperties.Name="Upper value" />
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Muzzle.PasswordStrengthMeter" TargetType="{x:Type mzc:PasswordStrengthMeter}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mzc:PasswordStrengthMeter}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="PART_Segments" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock x:Name="Label" Grid.Column="1" MinWidth="72" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                   FontWeight="SemiBold" Text="{TemplateBinding StrengthLabel}" Foreground="{TemplateBinding LabelBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowLabel" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GridSplitter: transparent hit area with a pill that grows and turns accent on hover / drag. -->
    <Style x:Key="Muzzle.GridSplitter" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Pill" Width="4" Height="32" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5"
                                Background="{DynamicResource Muzzle.Brush.ControlBorderStrong}">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Rows splitter (or Auto with a stretched width): lay the pill down. -->
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="Pill" Property="Width" Value="32" />
                            <Setter TargetName="Pill" Property="Height" Value="4" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeDirection" Value="Auto" />
                                <Condition Property="HorizontalAlignment" Value="Stretch" />
                                <Condition Property="VerticalAlignment" Value="Center" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Pill" Property="Width" Value="32" />
                            <Setter TargetName="Pill" Property="Height" Value="4" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Muzzle.Brush.PrimaryHover}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.5" Duration="0:0:0.35" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.5" Duration="0:0:0.35" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Muzzle.Ease.JellySoft}" />
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Muzzle.Ease.JellySoft}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Muzzle.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Muzzle.Brush.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type mzc:RangeSlider}" BasedOn="{StaticResource Muzzle.RangeSlider}" />
    <Style TargetType="{x:Type mzc:PasswordStrengthMeter}" BasedOn="{StaticResource Muzzle.PasswordStrengthMeter}" />
    <Style TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource Muzzle.GridSplitter}" />

</ResourceDictionary>