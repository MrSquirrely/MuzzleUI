<!--
    Muzzle jelly physics: shared easing functions and reusable storyboards.

    Storyboards without a TargetName animate the element that hosts the trigger and expect
    that element to have RenderTransformOrigin="0.5,0.5" and a ScaleTransform as RenderTransform:

        <Border RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                    <BeginStoryboard Storyboard="{StaticResource Muzzle.Storyboard.Boop}" />
                </EventTrigger>
            </Border.Triggers>
        </Border>
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Elastic: low oscillations, high springiness. -->
    <ElasticEase x:Key="Muzzle.Ease.Jelly" EasingMode="EaseOut" Oscillations="2" Springiness="6" po:Freeze="True" />
    <ElasticEase x:Key="Muzzle.Ease.JellySoft" EasingMode="EaseOut" Oscillations="1" Springiness="5" po:Freeze="True" />
    <ElasticEase x:Key="Muzzle.Ease.Wobble" EasingMode="EaseOut" Oscillations="3" Springiness="4" po:Freeze="True" />

    <!-- Back: a single soft overshoot. -->
    <BackEase x:Key="Muzzle.Ease.Back" EasingMode="EaseOut" Amplitude="0.5" po:Freeze="True" />
    <BackEase x:Key="Muzzle.Ease.BackSoft" EasingMode="EaseOut" Amplitude="0.4" po:Freeze="True" />
    <BackEase x:Key="Muzzle.Ease.BackStrong" EasingMode="EaseOut" Amplitude="0.6" po:Freeze="True" />
    <BackEase x:Key="Muzzle.Ease.BackIn" EasingMode="EaseIn" Amplitude="0.4" po:Freeze="True" />

    <!-- Plain curves for squish-in and fades. -->
    <CubicEase x:Key="Muzzle.Ease.Squish" EasingMode="EaseOut" po:Freeze="True" />
    <CubicEase x:Key="Muzzle.Ease.Smooth" EasingMode="EaseInOut" po:Freeze="True" />
    <QuinticEase x:Key="Muzzle.Ease.Glide" EasingMode="EaseOut" po:Freeze="True" />

    <!-- Hover: grow to 1.03 with a soft overshoot. -->
    <Storyboard x:Key="Muzzle.Storyboard.HoverGrow">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1.03" Duration="0:0:0.38" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1.03" Duration="0:0:0.38" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
    </Storyboard>

    <!-- Press: squish inward (0.94 x 0.92). -->
    <Storyboard x:Key="Muzzle.Storyboard.Squish">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="0.94" Duration="0:0:0.11" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="0.92" Duration="0:0:0.11" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
    </Storyboard>

    <!-- Release: bounce back to rest with an elastic overshoot. -->
    <Storyboard x:Key="Muzzle.Storyboard.Release">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1" Duration="0:0:0.72" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1" Duration="0:0:0.72" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
    </Storyboard>

    <!-- Settle: relax to 1.0 without bouncing much (mouse leave). -->
    <Storyboard x:Key="Muzzle.Storyboard.Settle">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Muzzle.Ease.BackSoft}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Muzzle.Ease.BackSoft}" />
    </Storyboard>

    <!-- Boop: squash-and-stretch wobble. -->
    <Storyboard x:Key="Muzzle.Storyboard.Boop">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.12" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Wobble}" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.88" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
            <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Wobble}" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- PopIn: fade + spring from 0.9 (popups, dialogs, freshly loaded cards). -->
    <Storyboard x:Key="Muzzle.Storyboard.PopIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.9" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.9" To="1" Duration="0:0:0.6" EasingFunction="{StaticResource Muzzle.Ease.Jelly}" />
    </Storyboard>

</ResourceDictionary>