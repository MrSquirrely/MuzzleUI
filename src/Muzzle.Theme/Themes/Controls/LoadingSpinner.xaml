<!--
    LoadingSpinner: ArcRing (an arc whipping round a pastel track with eased, springy turns and a gentle breathe)
    or BouncingDots (three pastel dots hopping in turn with squash-and-stretch).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mzc="clr-namespace:Muzzle.Theme.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Muzzle.Theme;component/Themes/Animations/JellyEasings.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BackEase x:Key="Muzzle.Spinner.Whip" EasingMode="EaseInOut" Amplitude="0.35" />

    <ControlTemplate x:Key="Muzzle.Spinner.ArcTemplate" TargetType="{x:Type mzc:LoadingSpinner}">
        <Grid x:Name="Root" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Ellipse Stroke="{DynamicResource Muzzle.Brush.Track}" StrokeThickness="{TemplateBinding Thickness}" />
            <Ellipse x:Name="PART_Arc"
                     Stroke="{TemplateBinding AccentBrush}"
                     StrokeThickness="{TemplateBinding Thickness}"
                     StrokeDashCap="Round"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Spin">
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Arc" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="300" EasingFunction="{StaticResource Muzzle.Spinner.Whip}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="720" EasingFunction="{StaticResource Muzzle.Spinner.Whip}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0.93" EasingFunction="{StaticResource Muzzle.Ease.Smooth}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.05" Value="0.93" EasingFunction="{StaticResource Muzzle.Ease.Smooth}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0.93" EasingFunction="{StaticResource Muzzle.Ease.Smooth}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.05" Value="0.93" EasingFunction="{StaticResource Muzzle.Ease.Smooth}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin" />
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsActive" Value="False">
                <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Muzzle.Spinner.Dot" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="RenderTransformOrigin" Value="0.5,1" />
    </Style>

    <ControlTemplate x:Key="Muzzle.Spinner.DotsTemplate" TargetType="{x:Type mzc:LoadingSpinner}">
        <StackPanel x:Name="Root" Height="30" Orientation="Horizontal" HorizontalAlignment="Center">
            <Ellipse x:Name="Dot1" Style="{StaticResource Muzzle.Spinner.Dot}" Fill="{TemplateBinding AccentBrush}">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot2" Style="{StaticResource Muzzle.Spinner.Dot}" Fill="{DynamicResource Muzzle.Brush.Secondary}">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dot3" Style="{StaticResource Muzzle.Spinner.Dot}" Fill="{DynamicResource Muzzle.Brush.Tertiary}">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Hop">
                        <!-- One 1.1s cycle; each dot squashes, springs up, lands and squashes again, 0.15s after the previous one. -->
                        <Storyboard RepeatBehavior="Forever" Duration="0:0:1.1">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="-14" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.25" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="0.88" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.3" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.75" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1.12" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.7" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.15" Storyboard.TargetName="Dot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="-14" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.15" Storyboard.TargetName="Dot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.25" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="0.88" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.3" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.15" Storyboard.TargetName="Dot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.75" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1.12" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.7" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.3" Storyboard.TargetName="Dot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="-14" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" EasingFunction="{StaticResource Muzzle.Ease.BackIn}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.3" Storyboard.TargetName="Dot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.25" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="0.88" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1.3" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="0:0:0.3" Storyboard.TargetName="Dot3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.75" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1.12" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.7" EasingFunction="{StaticResource Muzzle.Ease.Squish}" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="1" EasingFunction="{StaticResource Muzzle.Ease.Back}" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Hop" />
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsActive" Value="False">
                <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Muzzle.LoadingSpinner" TargetType="{x:Type mzc:LoadingSpinner}">
        <Setter Property="AccentBrush" Value="{DynamicResource Muzzle.Brush.Primary}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template" Value="{StaticResource Muzzle.Spinner.ArcTemplate}" />
        <Style.Triggers>
            <!-- Inactive spinners take no space (so a spinner inside a button doesn't leave a gap). -->
            <Trigger Property="IsActive" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="SpinnerStyle" Value="BouncingDots">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Height" Value="NaN" />
                <Setter Property="Template" Value="{StaticResource Muzzle.Spinner.DotsTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type mzc:LoadingSpinner}" BasedOn="{StaticResource Muzzle.LoadingSpinner}" />

</ResourceDictionary>