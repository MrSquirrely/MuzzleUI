    <Color x:Key="Muzzle.Color.BackdropCanvas">#B3FAF8F6</Color>
    <Color x:Key="Muzzle.Color.Shadow">#4B2E3B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Muzzle.Brush.Canvas" Color="{StaticResource Muzzle.Color.Canvas}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.CanvasAlt" Color="{StaticResource Muzzle.Color.CanvasAlt}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Surface" Color="{StaticResource Muzzle.Color.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SurfaceRaised" Color="{StaticResource Muzzle.Color.SurfaceRaised}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.SurfaceBorder" Color="{StaticResource Muzzle.Color.SurfaceBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.ControlBackground" Color="{StaticResource Muzzle.Color.ControlBackground}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.ControlBorder" Color="{StaticResource Muzzle.Color.ControlBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.ControlBorderHover" Color="{StaticResource Muzzle.Color.ControlBorderHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.ControlBorderStrong" Color="{StaticResource Muzzle.Color.ControlBorderStrong}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Track" Color="{StaticResource Muzzle.Color.Track}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.TrackHover" Color="{StaticResource Muzzle.Color.TrackHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Thumb" Color="{StaticResource Muzzle.Color.Thumb}" po:Freeze="True" />
    <SolidColorBrush x:Key="Muzzle.Brush.Primary" Color="{StaticResource Muzzle.Color.Primary}" po:Freeze="True" />
